# Abhängigkeiten und Build-Artefakte
node_modules/
dist/
.astro/
.wrangler/
*.tsbuildinfo

# Lokale Laufzeitprojektionen (aus Git deterministisch erzeugbar)
data/runtime/*.sqlite
data/runtime/*.sqlite-journal
data/runtime/*.sqlite-wal
data/runtime/*.sqlite-shm
data/runtime/*.sql
data/runtime/d1-batches/
data/runtime/projection-state-*.json

# Rohquellen: nur die archivierten Quellen des RECHT.NRW-Validierungskorpus sind versioniert
# (sources/recht-nrw/, siehe sources/README.md); lokale Arbeitsbereiche bleiben außen vor.
sources/**
!sources/README.md
!sources/recht-nrw/
!sources/recht-nrw/**
# Abrufcache und R2-Staging des Bulkimports (.cache/recht-nrw/, .cache/recht-nrw-r2-staging/)
.cache/

# Atomare Schreibvorgänge: halb geschriebene Temp-Dateien (common/atomic.ts, common/persist.ts)
.tmp-*
.old-norm-*

# Logs, Tests, Caches (auch R2_API_DEBUG-Diagnosen und npm-Cache der CI)
*.log
coverage/
test-results/
playwright-report/
.npm/

# Lokale Umgebungen und Wrangler-Geheimnisse (nie einchecken; Wranglers OAuth-Anmeldung liegt außerhalb
# des Repositorys unter ~/.wrangler bzw. dem Konfigurationsordner des Systems)
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
**/.wrangler/config/

# Editor- und Betriebssystemdateien
# .claude/launch.json ist lokale Vorschaukonfiguration (Port, Startbefehl) und nicht Teil des Projekts.
.claude/launch.json
.DS_Store
Thumbs.db
.vscode/
.idea/
