{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "../../packages/legal-core/src/**/*",
    "../../packages/search/src/**/*",
    "../../packages/runtime/src/**/*",
    "../../packages/providers/src/**/*"
  ],
  "exclude": ["dist"]
}
