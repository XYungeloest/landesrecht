---
import { JURISDICTION_LIST, SIMULATION_BASELINE_DATE, formatBaselineDate } from '@landesrecht/legal-core/config/jurisdictions.ts';
import { EDITORIAL_REFERENCE_DATE } from '@landesrecht/legal-core/config/editorial.ts';
import { referenceDateLabel, VOCABULARY } from '@landesrecht/legal-core/lib/display.ts';
import { getJurisdictionUrl, PORTAL_PATHS } from '@landesrecht/legal-core/lib/routes.ts';
import '../styles/base.css';
import ResponsiveDisclosure from '../components/ResponsiveDisclosure.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  robots?: string;
}

const { title, description = VOCABULARY.portalSubtitle, canonical, robots } = Astro.props;
const isActive = (url: string) => Astro.url.pathname === url || (url !== PORTAL_PATHS.home && Astro.url.pathname.startsWith(url));
const siteUrl = import.meta.env.PUBLIC_SITE_URL;
const fullTitle = title === VOCABULARY.portalName ? title : `${title} – ${VOCABULARY.portalName}`;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={`${siteUrl}${canonical}`} />}
    {robots && <meta name="robots" content={robots} />}
    <link rel="icon" href="/favicon.png" type="image/png" />
  </head>
  <body>
    <a class="skip-link" href="#hauptinhalt">Zum Inhalt springen</a>
    <div class="notice-bar" role="note">
      <strong>Simulation:</strong> {VOCABULARY.simulationNotice}
    </div>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-brand" href={PORTAL_PATHS.home}>
          <img src="/bild-wortmarke.png" width="1536" height="1024" alt={VOCABULARY.portalName} fetchpriority="high" />
        </a>
        <ResponsiveDisclosure class="site-menu" label="Menü">
        <nav class="site-nav" aria-label="Hauptnavigation">
          <ul>
            {JURISDICTION_LIST.map((jurisdiction) => (
              <li><a href={getJurisdictionUrl(jurisdiction.id)} title={jurisdiction.name} aria-current={isActive(getJurisdictionUrl(jurisdiction.id)) ? 'page' : undefined}>{jurisdiction.shortName}</a></li>
            ))}
            <li><a href={PORTAL_PATHS.changes} aria-current={isActive(PORTAL_PATHS.changes) ? 'page' : undefined}>Änderungen</a></li>
            <li><a href={PORTAL_PATHS.search} aria-current={isActive(PORTAL_PATHS.search) ? 'page' : undefined}>Suche</a></li>
            <li><a href={PORTAL_PATHS.help} aria-current={isActive(PORTAL_PATHS.help) ? 'page' : undefined}>Hilfe</a></li>
          </ul>
        </nav>
        </ResponsiveDisclosure>
      </div>
    </header>
    <main id="hauptinhalt" class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>{VOCABULARY.officialNote}</p>
      <p>{VOCABULARY.baselineLabel} aller Länder: {formatBaselineDate(SIMULATION_BASELINE_DATE)} · {referenceDateLabel(EDITORIAL_REFERENCE_DATE)}</p>
      <p><a href={PORTAL_PATHS.about}>Über den Rechtsbestand</a> · <a href={PORTAL_PATHS.changes}>Änderungen in der Simulation</a> · <a href={PORTAL_PATHS.simrecht}>Schnittstelle</a> · <a href={PORTAL_PATHS.imprint}>Impressum</a></p>
    </footer>
  </body>
</html>
