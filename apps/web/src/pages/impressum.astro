---
import { VOCABULARY } from '@landesrecht/legal-core/lib/display.ts';
import { PORTAL_PATHS } from '@landesrecht/legal-core/lib/routes.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Impressum" canonical={PORTAL_PATHS.imprint}>
  <h1>Impressum</h1>
  <p>{VOCABULARY.simulationNotice}</p>
  <p>Dieses Portal ist ein fiktives Internetangebot einer politischen Simulation. Es stellt keine amtliche Veröffentlichung eines realen Landes dar und begründet keine Rechtswirkungen. Die Angaben zu Verantwortlichen werden vor der Veröffentlichung ergänzt.</p>
</BaseLayout>
