---
import { PORTAL_PATHS } from '@landesrecht/legal-core/lib/routes.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Kontakt" canonical={PORTAL_PATHS.contact} robots="noindex, follow">
  <h1>Kontakt</h1>
  <p>Ein Betreiberkontakt ist noch nicht hinterlegt. Diese Seite ist noch nicht für den öffentlichen Betrieb freigegeben.</p>
  <p>Vor Freigabe müssen eine erreichbare Kontaktadresse und die zuständige Redaktion benannt werden. Betreiberangaben gehören ins <a href={PORTAL_PATHS.imprint}>Impressum</a>.</p>
  <p>Hinweise zu Vorschriften: <a href={PORTAL_PATHS.feedback}>Fehler melden</a>.</p>
</BaseLayout>
