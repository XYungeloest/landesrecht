---
export const prerender = false;
import ProvisionPage from '../../../../../../components/ProvisionPage.astro';
import { jurisdictionFromParam, loadNormView } from '../../../../../../lib/norm-view.ts';
import { getStoreRegistry, PAGE_CACHE_CONTROL } from '../../../../../../lib/runtime/context.ts';
import { resolveProvisionSelection } from '../../../../../../lib/provision-navigation.ts';
import { getProvisionUrl } from '@landesrecht/legal-core/lib/routes.ts';
import { getProvisionEntries } from '@landesrecht/legal-core/lib/body.ts';
const resolved = jurisdictionFromParam(Astro.params.jurisdiction);
if (!resolved || !Astro.params.slug) return Astro.rewrite('/404');
const registry = await getStoreRegistry();
if (!registry.has(resolved.id)) return Astro.rewrite('/404');
const view = await loadNormView(registry.get(resolved.id), Astro.params.slug, Astro.params.versionId);
if (!view) return Astro.rewrite('/404');
const entries = getProvisionEntries(view.version.body, view.anchors);
const entry = entries.find((item) => item.anchor === Astro.params.provision);
if (!entry) return Astro.rewrite('/404');
if (Astro.url.searchParams.has('vorschrift')) {
  const selected = resolveProvisionSelection(Astro.url.searchParams,entries);
  if (!selected) return Astro.rewrite('/404');
  const targetUrl = getProvisionUrl(view.jurisdiction.id,view.record.meta.slug,selected.anchor,view.version.versionId);
  return Astro.redirect(targetUrl,303);
}
Astro.response.headers.set('Cache-Control', PAGE_CACHE_CONTROL);
---
<ProvisionPage view={view} entry={entry} explicitVersion={true} />
