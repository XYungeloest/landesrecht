---
export const prerender = false;

import { formatDate, VOCABULARY } from '@landesrecht/legal-core/lib/display.ts';
import { collectBlockText } from '@landesrecht/legal-core/lib/body.ts';
import type { NormBodyBlock, NormVersion } from '@landesrecht/legal-core/lib/schema.ts';
import NormPageShell from '../../../../components/NormPageShell.astro';
import { buildNormView, jurisdictionFromParam } from '../../../../lib/norm-view.ts';
import { getStoreRegistry, PAGE_CACHE_CONTROL } from '../../../../lib/runtime/context.ts';

const resolved = jurisdictionFromParam(Astro.params.jurisdiction);
if (!resolved || !Astro.params.slug) return Astro.rewrite('/404');
const registry = await getStoreRegistry();
if (!registry.has(resolved.id)) return Astro.rewrite('/404');
const record = await registry.get(resolved.id).getNorm(Astro.params.slug, 'all');
const view = record ? buildNormView(record) : null;
if (!record || !view) return Astro.rewrite('/404');
Astro.response.headers.set('Cache-Control', PAGE_CACHE_CONTROL);

// Standardvergleich: Ausgangsfassung (Ausgangsrechtsstand) ↔ geltende Fassung; Einzelvergleiche bleiben über „von“/„bis“ wählbar.
const currentId = view.versions.find((entry) => entry.kind === 'current')?.versionId ?? record.versions.at(-1)!.versionId;
const fromId = Astro.url.searchParams.get('von') ?? view.baselineVersion?.versionId ?? record.versions[0]!.versionId;
const toId = Astro.url.searchParams.get('bis') ?? currentId;
const baselineDate = view.jurisdiction.baselineDate;
const versionLabel = (version: NormVersion): string => (version.simulationValidFrom === baselineDate ? `${VOCABULARY.simulationChange.baselineVersion} (${formatDate(version.simulationValidFrom)})` : version.versionId === currentId ? `${VOCABULARY.simulationChange.currentVersion} (seit ${formatDate(version.simulationValidFrom)})` : `Fassung vom ${formatDate(version.simulationValidFrom)}`);
const from = record.versions.find((version) => version.versionId === fromId);
const to = record.versions.find((version) => version.versionId === toId);

/** Vorbereitung des Fassungsvergleichs: Einheiten je Fassung gegenüberstellen (noch ohne Wortdiff). */
function unitTexts(version: NormVersion): Map<string, string> {
  const result = new Map<string, string>();
  const visit = (blocks: NormBodyBlock[], quoted: boolean): void => {
    for (const block of blocks) {
      if (!quoted && (block.type === 'paragraph' || block.type === 'article' || block.type === 'annex')) {
        result.set([block.label, block.title].filter(Boolean).join(' '), collectBlockText(block).join('\n'));
        continue;
      }
      if (block.children) visit(block.children, quoted || block.type === 'quotedProvision');
    }
  };
  visit(version.body, false);
  return result;
}
const left = from ? unitTexts(from) : new Map<string, string>();
const right = to ? unitTexts(to) : new Map<string, string>();
const keys = [...new Set([...left.keys(), ...right.keys()])];
const changed = keys.filter((key) => left.get(key) !== right.get(key));
---
<NormPageShell view={view} section="vergleich" title={`${VOCABULARY.sections.compare}: ${view.identity.shortTitle} (${view.jurisdiction.shortName})`}>
  <h2>{VOCABULARY.simulationChange.changesSince}</h2>
  {view.change.kind === 'baseline-unchanged' && <p class="muted">Diese Vorschrift gilt seit dem Ausgangsrechtsstand vom {formatDate(baselineDate)} unverändert; es gibt nichts zu vergleichen.</p>}
  {view.change.kind === 'simulation-new' && record.versions.length < 2 && <p class="muted">Diese Vorschrift wurde in der Simulation neu erlassen und seither nicht geändert.</p>}
  {record.versions.length >= 2 && (
    <form class="search-form compare-form" method="get" aria-label="Fassungen zum Vergleich wählen">
      <label>Von <select name="von">{record.versions.map((version) => <option value={version.versionId} selected={version.versionId === fromId}>{versionLabel(version)}</option>)}</select></label>
      <label>Bis <select name="bis">{record.versions.map((version) => <option value={version.versionId} selected={version.versionId === toId}>{versionLabel(version)}</option>)}</select></label>
      <button type="submit">Vergleichen</button>
    </form>
  )}
  {!from || !to ? <p class="muted">Unbekannte Fassung.</p> : record.versions.length < 2 ? null : (
    <section>
      <h3>{changed.length} geänderte {changed.length === 1 ? 'Vorschrift' : 'Vorschriften'} zwischen {versionLabel(from)} und {versionLabel(to)}</h3>
      <p class="muted">Gegenüberstellung je Paragraf bzw. Artikel; Unterschiede im Wortlaut sind an den Texten selbst erkennbar.</p>
      {changed.map((key) => (
        <div class="card">
          <h4>{key}{!left.has(key) ? ' (neu)' : !right.has(key) ? ' (entfallen)' : ''}</h4>
          <div class="comparison-columns">
            <div><p class="muted">{versionLabel(from)}</p><p>{left.get(key) ?? '–'}</p></div>
            <div><p class="muted">{versionLabel(to)}</p><p>{right.get(key) ?? '–'}</p></div>
          </div>
        </div>
      ))}
    </section>
  )}
</NormPageShell>
