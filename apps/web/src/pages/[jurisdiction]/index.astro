---
export const prerender = false;

import { formatBaselineDate } from '@landesrecht/legal-core/config/jurisdictions.ts';
import { statusLabel, typeLabel, VOCABULARY } from '@landesrecht/legal-core/lib/display.ts';
import { PORTAL_PATHS } from '@landesrecht/legal-core/lib/routes.ts';
import { ADMINISTRATIVE_REGULATION_TYPES, expandNormTypeFilter, isNormType, NORM_TYPES, type NormType } from '@landesrecht/legal-core/lib/schema.ts';
import InventoryNotice from '../../components/InventoryNotice.astro';
import SearchForm from '../../components/SearchForm.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { jurisdictionFromParam } from '../../lib/norm-view.ts';
import { getStoreRegistry, PAGE_CACHE_CONTROL } from '../../lib/runtime/context.ts';

const resolved = jurisdictionFromParam(Astro.params.jurisdiction);
if (!resolved) return Astro.rewrite('/404');
const { id, jurisdiction } = resolved;
const registry = await getStoreRegistry();
if (!registry.has(id)) return Astro.rewrite('/404');
const store = registry.get(id);
// Typzähler aus einer aggregierten Abfrage über den gesamten Bestand – nie aus der begrenzten Liste.
const [typeCountRows, stats] = await Promise.all([store.countNormsByType(), store.getStats()]);
const totalCount = typeCountRows.reduce((sum, entry) => sum + entry.count, 0);
const typeParam = Astro.url.searchParams.get('type') ?? '';
const selectedType: NormType | undefined = isNormType(typeParam) ? typeParam : undefined;
const isAdministrative = (type: NormType): boolean => (ADMINISTRATIVE_REGULATION_TYPES as readonly string[]).includes(type);
const typeCounts = NORM_TYPES.map((type) => ({ type, count: typeCountRows.find((entry) => entry.type === type)?.count ?? 0 })).filter((entry) => entry.count > 0);
const administrativeCount = typeCountRows.filter((entry) => isAdministrative(entry.type)).reduce((sum, entry) => sum + entry.count, 0);
// Gefilterte Listen laden ihre Typen vollständig; die ungefilterte Liste bleibt auf LIST_LIMIT begrenzt.
const LIST_LIMIT = 500;
const listTypes = selectedType ? expandNormTypeFilter([selectedType]) : undefined;
const visibleNorms = listTypes
  ? (await Promise.all(listTypes.map((type) => store.listNormSummaries({ type, limit: 5000 })))).flat().sort((left, right) => left.title.localeCompare(right.title, 'de') || left.slug.localeCompare(right.slug))
  : await store.listNormSummaries({ limit: LIST_LIMIT });
const visibleTotal = listTypes ? typeCountRows.filter((entry) => listTypes.includes(entry.type)).reduce((sum, entry) => sum + entry.count, 0) : totalCount;
const basePath = `/${jurisdiction.pathSegment}/`;
const filterUrl = (type?: NormType): string => (type ? `${basePath}?type=${encodeURIComponent(type)}` : basePath);
Astro.response.headers.set('Cache-Control', PAGE_CACHE_CONTROL);
---
<BaseLayout title={jurisdiction.name} description={`Landesrecht des ${jurisdiction.name}: Gesetze, Verordnungen und Verwaltungsvorschriften der Simulation.`} canonical={`/${jurisdiction.pathSegment}/`}>
  <nav class="breadcrumbs" aria-label="Brotkrumen"><ol><li><a href={PORTAL_PATHS.home}>{VOCABULARY.portalName}</a></li><li>{jurisdiction.name}</li></ol></nav>
  <h1>{jurisdiction.name}</h1>
  <p class="lead">Kurzbezeichnung: <strong>{jurisdiction.shortName}</strong> · {VOCABULARY.baselineLabel}: <strong>{formatBaselineDate(jurisdiction.baselineDate)}</strong></p>
  <p>Der Rechtsbestand des {jurisdiction.name} beginnt mit dem Rechtsstand vom {formatBaselineDate(jurisdiction.baselineDate)}. Übernommen wird das reale Recht des Landes {jurisdiction.sourceSystem.realWorldState} ({jurisdiction.sourceSystem.portalLabel}); spätere Änderungen entstehen ausschließlich in der Simulation.</p>
  {jurisdiction.externalSourceOfTruth && (
    <p><strong>Hinweis:</strong> Der Rechtsbestand des {jurisdiction.name} wird derzeit in <a href={jurisdiction.externalSourceOfTruth.siteUrl} rel="noopener noreferrer">{jurisdiction.externalSourceOfTruth.label}</a> gepflegt. Dieses Portal zeigt nur Testbestände und übernimmt Normen später über die OstRecht-Schnittstelle.</p>
  )}
  <InventoryNotice jurisdiction={id} />
  <SearchForm state={{ jurisdictions: [id] }} />
  <section aria-labelledby="normen-heading">
    <h2 id="normen-heading">Vorhandene Normen ({stats.normCount})</h2>
    {totalCount > 0 && (
      <nav aria-label="Nach Normtyp filtern">
        <ul class="type-filter">
          <li><a href={filterUrl()} aria-current={selectedType ? undefined : 'true'}>{VOCABULARY.typeFilter.all} ({totalCount})</a></li>
          {typeCounts.filter((entry) => !isAdministrative(entry.type)).map((entry) => (
            <li><a href={filterUrl(entry.type)} aria-current={selectedType === entry.type ? 'true' : undefined}>{typeLabel(entry.type)} ({entry.count})</a></li>
          ))}
          {administrativeCount > 0 && <li><a href={filterUrl('verwaltungsvorschrift')} aria-current={selectedType === 'verwaltungsvorschrift' ? 'true' : undefined}>{VOCABULARY.typeFilter.administrativeFamily} ({administrativeCount})</a></li>}
          {typeCounts.filter((entry) => entry.type !== 'verwaltungsvorschrift' && isAdministrative(entry.type)).map((entry) => (
            <li><a href={filterUrl(entry.type)} aria-current={selectedType === entry.type ? 'true' : undefined}>{typeLabel(entry.type)} ({entry.count})</a></li>
          ))}
        </ul>
      </nav>
    )}
    {selectedType && <p class="muted">{visibleNorms.length} von {visibleTotal} Normen: {selectedType === 'verwaltungsvorschrift' ? VOCABULARY.typeFilter.administrativeFamily : typeLabel(selectedType)}.</p>}
    {!selectedType && totalCount > visibleNorms.length && <p class="muted">Die Liste zeigt die ersten {visibleNorms.length} von {totalCount} Normen; über die Typfilter und die Suche ist der gesamte Bestand erreichbar.</p>}
    {visibleNorms.length === 0 ? <p class="muted">{totalCount === 0 ? 'Noch keine Normen im Bestand.' : 'Keine Normen dieses Typs.'}</p> : (
      <ul class="hit-list">
        {visibleNorms.map((norm) => (
          <li class="hit">
            <h3 class="hit__title"><a href={norm.url}>{norm.title}</a></h3>
            <p class="hit__meta">{norm.shortTitle}{norm.abbr && ` · ${norm.abbr}`} · {typeLabel(norm.type)} · {statusLabel(norm.status)} · {norm.versionCount} {norm.versionCount === 1 ? 'Fassung' : 'Fassungen'}</p>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
