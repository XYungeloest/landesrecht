---
export const prerender = false;

import { formatBaselineDate, jurisdictionGenitive } from '@landesrecht/legal-core/config/jurisdictions.ts';
import { formatDate, VOCABULARY } from '@landesrecht/legal-core/lib/display.ts';
import { getPublicationLabel } from '@landesrecht/legal-core/lib/publications.ts';
import { getPublicationsUrl, getPublicationUrl, PORTAL_PATHS } from '@landesrecht/legal-core/lib/routes.ts';
import InventoryNotice from '../../components/InventoryNotice.astro';
import NormListing from '../../components/NormListing.astro';
import SearchForm from '../../components/SearchForm.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listingTypes, PAGE_SIZE, parseListingState } from '../../lib/norm-listing.ts';
import { jurisdictionFromParam } from '../../lib/norm-view.ts';
import { getStoreRegistry, PAGE_CACHE_CONTROL } from '../../lib/runtime/context.ts';

const resolved = jurisdictionFromParam(Astro.params.jurisdiction);
if (!resolved) return Astro.rewrite('/404');
const { id, jurisdiction } = resolved;
const registry = await getStoreRegistry();
if (!registry.has(id)) return Astro.rewrite('/404');
const store = registry.get(id);
const state = parseListingState(Astro.url.searchParams);
const types = listingTypes(state.type);
const facetQuery = { ...(types ? { types } : {}), ...(state.changeKind ? { changeKind: state.changeKind } : {}), ...(state.letter ? { letter: state.letter } : {}) };
// Zählwerte über den gesamten Bestand (Facetten); die Reiter zählen ohne Typ- und Buchstabenfilter.
const [facets, tabFacets, publications] = await Promise.all([store.countNormFacets(facetQuery), store.countNormFacets(), store.listPublications({ limit: 5 })]);
const norms = await store.listNormSummaries({ ...facetQuery, sort: state.changeKind ? 'change' : 'title', limit: PAGE_SIZE, offset: (Math.max(1, state.page) - 1) * PAGE_SIZE });
const basePath = `/${jurisdiction.pathSegment}/`;
const publicationCount = (await store.listPublications()).length;
Astro.response.headers.set('Cache-Control', PAGE_CACHE_CONTROL);
---
<BaseLayout title={jurisdiction.name} description={`Landesrecht des ${jurisdictionGenitive(jurisdiction)}: Gesetze, Verordnungen und Verwaltungsvorschriften – Ausgangsrechtsstand vom ${formatBaselineDate(jurisdiction.baselineDate)} und Änderungen der Simulation.`} canonical={basePath}>
  <nav class="breadcrumbs" aria-label="Brotkrumen"><ol><li><a href={PORTAL_PATHS.home}>{VOCABULARY.portalName}</a></li><li>{jurisdiction.name}</li></ol></nav>
  <h1>{jurisdiction.name}</h1>
  <p class="lead">Gesetze, Verordnungen und Verwaltungsvorschriften des {jurisdictionGenitive(jurisdiction)} ({jurisdiction.shortName}). Ausgangspunkt ist der Rechtsstand vom {formatBaselineDate(jurisdiction.baselineDate)}; alle späteren Änderungen stammen aus der Politiksimulation.</p>
  <InventoryNotice jurisdiction={id} />
  <SearchForm state={{ jurisdictions: [id] }} />
  <section aria-labelledby="normen-heading">
    <h2 id="normen-heading">Vorschriften</h2>
    <NormListing basePath={basePath} state={state} facets={facets} tabCounts={tabFacets.byChangeKind} norms={norms} headingId="normen" />
  </section>
  <section aria-labelledby="verkuendungen-heading">
    <h2 id="verkuendungen-heading"><a href={getPublicationsUrl(id)}>Verkündungen</a></h2>
    {publications.length === 0 ? (
      <p class="muted">Noch keine Ausgaben der Verkündungsblätter.</p>
    ) : (
      <>
        <ul class="publication-series">
          {publications.map((publication) => (
            <li><a href={getPublicationUrl(id, publication.slug)}>{getPublicationLabel(publication)}</a> <span class="muted">· {formatDate(publication.date)} · {publication.entries.length} {publication.entries.length === 1 ? 'Eintrag' : 'Einträge'}</span></li>
          ))}
        </ul>
        <p><a class="button-link button-secondary" href={getPublicationsUrl(id)}>Alle Ausgaben{publicationCount > publications.length && ` (${publicationCount})`}</a></p>
      </>
    )}
  </section>
</BaseLayout>
