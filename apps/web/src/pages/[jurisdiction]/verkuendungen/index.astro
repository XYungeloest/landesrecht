---
export const prerender = false;

import { jurisdictionGenitive } from '@landesrecht/legal-core/config/jurisdictions.ts';
import { formatDate, typeLabel, VOCABULARY } from '@landesrecht/legal-core/lib/display.ts';
import { getPublicationLabel, publicationEntryPages, summarizePublicationSeries } from '@landesrecht/legal-core/lib/publications.ts';
import { getJurisdictionUrl, getPublicationsUrl, getPublicationUrl, PORTAL_PATHS } from '@landesrecht/legal-core/lib/routes.ts';
import InventoryNotice from '../../../components/InventoryNotice.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { jurisdictionFromParam } from '../../../lib/norm-view.ts';
import { entryLinkKey, resolveEntryLinks } from '../../../lib/publication-view.ts';
import { getStoreRegistry, PAGE_CACHE_CONTROL } from '../../../lib/runtime/context.ts';

// Verkündungsblatt-Ausgaben der Simulation (docs/SIM_LAW_PROGRESSION.md 5.1 Schritt 8, Vorbild OstRecht
// apps/recht/src/pages/verkuendungen/index.astro): jüngste Ausgabe zuerst, Blattname wie gedruckt, Einträge mit
// Link auf Norm bzw. entstandene Fassung. Die heutige Jurisdiktion steht in der Brotkrume; historische
// Blattbezeichnungen werden nicht umbenannt.
const resolved = jurisdictionFromParam(Astro.params.jurisdiction);
if (!resolved) return Astro.rewrite('/404');
const { id, jurisdiction } = resolved;
const registry = await getStoreRegistry();
if (!registry.has(id)) return Astro.rewrite('/404');
const store = registry.get(id);
const publications = await store.listPublications();
const links = await resolveEntryLinks(store, id, publications);
const series = summarizePublicationSeries(publications);
const yearParam = Astro.url.searchParams.get('jahr') ?? '';
const gazetteParam = Astro.url.searchParams.get('blatt') ?? '';
const years = [...new Set(publications.map((publication) => publication.year))].sort((left, right) => right - left);
const selectedYear = /^\d{4}$/u.test(yearParam) && years.includes(Number(yearParam)) ? Number(yearParam) : undefined;
const selectedGazette = series.some((entry) => entry.gazette === gazetteParam) ? gazetteParam : undefined;
const visible = publications.filter((publication) => (selectedYear === undefined || publication.year === selectedYear) && (selectedGazette === undefined || publication.gazette === selectedGazette));
const basePath = getPublicationsUrl(id);
const filterUrl = (params: { jahr?: number; blatt?: string }): string => {
  const search = new URLSearchParams();
  if (params.jahr !== undefined) search.set('jahr', String(params.jahr));
  if (params.blatt) search.set('blatt', params.blatt);
  const query = search.toString();
  return query ? `${basePath}?${query}` : basePath;
};
const filtered = selectedYear !== undefined || selectedGazette !== undefined;
Astro.response.headers.set('Cache-Control', PAGE_CACHE_CONTROL);
---
<BaseLayout title={`Verkündungen (${jurisdiction.shortName})`} description={`Verkündungsblätter der Simulation des ${jurisdictionGenitive(jurisdiction)}: Ausgaben mit Datum, Nummer und den verkündeten Rechtsakten.`} canonical={basePath} robots={filtered ? 'noindex, follow' : undefined}>
  <nav class="breadcrumbs" aria-label="Brotkrumen"><ol><li><a href={PORTAL_PATHS.home}>{VOCABULARY.portalName}</a></li><li><a href={getJurisdictionUrl(id)}>{jurisdiction.name}</a></li><li>Verkündungen</li></ol></nav>
  <h1>Verkündungen des {jurisdictionGenitive(jurisdiction)}</h1>
  <p class="lead">Ausgaben der Verkündungsblätter der Simulation seit dem Ausgangsrechtsstand. {VOCABULARY.officialNote}</p>
  <p class="muted">Blattbezeichnungen erscheinen, wie sie gedruckt wurden; frühere Bezeichnungen des Landes bleiben erhalten und werden bei der Ausgabe erläutert. Amtliches Blatt des Landes heute: {jurisdiction.gazette.title} ({jurisdiction.gazette.abbreviation}).</p>
  <InventoryNotice jurisdiction={id} />
  {series.length > 0 && (
    <section aria-labelledby="reihen-heading">
      <h2 id="reihen-heading">Blattreihen</h2>
      <ul class="publication-series">
        {series.map((entry) => (
          <li>
            <a href={filterUrl({ blatt: entry.gazette })} aria-current={selectedGazette === entry.gazette ? 'true' : undefined}><strong>{entry.gazette}</strong></a>
            {entry.seriesTitle && <span> – {entry.seriesTitle}</span>}
            <span class="muted"> · {entry.years} · {entry.count} {entry.count === 1 ? 'Ausgabe' : 'Ausgaben'}</span>
            {entry.regime && <p class="muted">{entry.regime}</p>}
          </li>
        ))}
      </ul>
      {years.length > 1 && (
        <nav aria-label="Nach Jahrgang filtern">
          <ul class="type-filter">
            <li><a href={filterUrl({ blatt: selectedGazette })} aria-current={selectedYear === undefined ? 'true' : undefined}>Alle Jahrgänge</a></li>
            {years.map((year) => <li><a href={filterUrl({ jahr: year, blatt: selectedGazette })} aria-current={selectedYear === year ? 'true' : undefined}>{year}</a></li>)}
          </ul>
        </nav>
      )}
    </section>
  )}
  <section aria-labelledby="ausgaben-heading">
    <h2 id="ausgaben-heading">Ausgaben ({visible.length}{filtered ? ` von ${publications.length}` : ''})</h2>
    {filtered && <p class="muted"><a href={basePath}>Auswahl zurücksetzen</a></p>}
    {visible.length === 0 ? (
      <p class="muted">{publications.length === 0 ? 'Noch keine Verkündungen der Simulation übernommen.' : 'Keine Ausgaben in dieser Auswahl.'}</p>
    ) : (
      <ol class="publication-list">
        {visible.map((publication) => (
          <li class="publication">
            <h3 class="publication__title"><a href={getPublicationUrl(id, publication.slug)}>{getPublicationLabel(publication)}</a></h3>
            <p class="publication__meta">
              <time datetime={publication.date}>{formatDate(publication.date)}</time>
              {' · '}{publication.seriesTitle ?? publication.gazette}{publication.place && ` · ${publication.place}`} · {publication.title}
            </p>
            {publication.entries.length === 0 ? <p class="muted">Keine Einträge.</p> : (
              <ul class="publication__entries">
                {publication.entries.map((entry) => {
                  const link = links.get(entryLinkKey(entry));
                  const pages = publicationEntryPages(entry);
                  return (
                    <li>
                      <span>{entry.title}</span>
                      <span class="muted"> – {entry.citation}{pages && ` · ${pages}`}{entry.type && ` · ${typeLabel(entry.type)}`}</span>
                      {link ? <> · <a href={link.href}>{link.label}</a>{link.historyUrl && <> · <a href={link.historyUrl}>{VOCABULARY.sections.history}</a></>}</> : <span class="muted"> · Norm nicht im Bestand</span>}
                    </li>
                  );
                })}
              </ul>
            )}
          </li>
        ))}
      </ol>
    )}
  </section>
</BaseLayout>
