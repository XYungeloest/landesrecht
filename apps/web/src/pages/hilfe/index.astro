---
import { JURISDICTION_LIST, SIMULATION_BASELINE_DATE, formatBaselineDate } from '@landesrecht/legal-core/config/jurisdictions.ts';
import { VOCABULARY } from '@landesrecht/legal-core/lib/display.ts';
import { PORTAL_PATHS } from '@landesrecht/legal-core/lib/routes.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Hilfe" canonical={PORTAL_PATHS.help}>
  <h1>Hilfe</h1>
  <h2>Was ist dieses Portal?</h2>
  <p>{VOCABULARY.portalName} ist das gemeinsame Rechtsportal der Länder {JURISDICTION_LIST.map((jurisdiction) => jurisdiction.name).join(', ')} innerhalb einer politischen Simulation. {VOCABULARY.simulationNotice}</p>
  <h2>Ausgangsrechtsstand und Fassungen</h2>
  <p>Alle Länder beginnen mit dem Rechtsstand vom {formatBaselineDate(SIMULATION_BASELINE_DATE)}. Jede Fassung einer Vorschrift gilt ab einem bestimmten Tag; frühere Fassungen bleiben unverändert abrufbar. Vorschriften, die seit dem Ausgangsstand in der Simulation geändert oder neu erlassen wurden, sind als „{VOCABULARY.simulationChange.byKind['baseline-changed']}“ bzw. „{VOCABULARY.simulationChange.byKind['simulation-new']}“ gekennzeichnet; unverändertes Ausgangsrecht trägt keine Kennzeichnung. Die Seite <a href={PORTAL_PATHS.changes}>Änderungen in der Simulation</a> listet sie über alle Länder, <a href={PORTAL_PATHS.about}>Über den Rechtsbestand</a> erklärt die Grundlagen.</p>
  <h2>Suche</h2>
  <p>Die Suche findet Bezeichnungen, Abkürzungen, Normtext und Fundstellen. Angaben wie „§ 3 Absatz 2“ oder „Art. 5“ führen direkt zur Vorschrift; über den Geltungstag lässt sich die an einem Datum geltende Fassung ermitteln, und der Filter „{VOCABULARY.simulationChange.label}“ beschränkt die Treffer auf geänderte oder neue Vorschriften.</p>
  <h2>Adressen</h2>
  <ul>
    {JURISDICTION_LIST.map((jurisdiction) => <li><code>/{jurisdiction.pathSegment}/norm/&lt;kurzadresse&gt;/</code> – {jurisdiction.name}</li>)}
    <li><code>…/version/&lt;jjjj-mm-tt&gt;/</code> – dauerhafte Adresse einer Fassung</li>
    <li><code>/&lt;land&gt;/?stand=changed</code> bzw. <code>?stand=new</code> – geänderte bzw. neue Vorschriften eines Landes</li>
    <li><code>{PORTAL_PATHS.simrecht}</code> – maschinenlesbare Beschreibung der Schnittstelle</li>
  </ul>
</BaseLayout>
