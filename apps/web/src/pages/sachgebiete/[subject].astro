---
export const prerender = false;
import { getSubjectGroup, SUBJECT_COVERAGE_NOTICE } from '@landesrecht/legal-core/config/subjects.ts';
import { getJurisdiction, isJurisdictionId } from '@landesrecht/legal-core/config/jurisdictions.ts';
import { getSubjectsUrl, getSearchUrl, PORTAL_PATHS } from '@landesrecht/legal-core/lib/routes.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NormListing from '../../components/NormListing.astro';
import { getStoreRegistry, PAGE_CACHE_CONTROL } from '../../lib/runtime/context.ts';
import { parseListingState, listingUrl } from '../../lib/norm-listing.ts';
import { subjectCoverage, subjectListing } from '../../lib/subjects.ts';
const group = getSubjectGroup(Astro.params.subject ?? '');
if (!group) return Astro.rewrite('/404');
const registry = await getStoreRegistry();
const rawLand = Astro.url.searchParams.get('land');
const land = isJurisdictionId(rawLand) ? rawLand : undefined;
if (land) registry.get(land);
const coverage = await subjectCoverage(registry);
const supported = coverage.filter((entry) => (entry.groups.find((g) => g.id === group.id)?.count ?? 0)>0);
if (land && !supported.some((entry) => entry.jurisdiction === land)) return Astro.redirect(getSubjectsUrl(undefined,land),303);
if (!supported.length) return Astro.redirect(getSubjectsUrl(),303);
const result = await subjectListing(registry,group.id,parseListingState(Astro.url.searchParams),land);
const basePath = getSubjectsUrl(group.id,land);
Astro.response.headers.set('Cache-Control',PAGE_CACHE_CONTROL);
---
<BaseLayout title={group.title} canonical={getSubjectsUrl(group.id)}>
  <nav class="breadcrumbs" aria-label="Brotkrumen"><ol><li><a href={PORTAL_PATHS.home}>Landesrecht</a></li><li><a href={getSubjectsUrl()}>Sachgebiete</a></li><li>{group.title}</li></ol></nav>
  <h1>{group.title}</h1><p class="lead">{group.description}</p>
  <p class="muted">{SUBJECT_COVERAGE_NOTICE}</p>
  {registry.unavailable().length > 0 && <p role="note" class="muted">Im Entwicklungsbetrieb sind einzelne Länder nicht oder nur auszugsweise lokal verfügbar.</p>}
  <nav aria-label="Land wählen"><ul class="type-filter"><li><a href={listingUrl(getSubjectsUrl(group.id),{...result.state,page:1})} aria-current={!land ? 'true' : undefined}>Alle Länder</a></li>
    {supported.map((entry) => <li><a href={listingUrl(getSubjectsUrl(group.id,entry.jurisdiction),{...result.state,page:1})} aria-current={land===entry.jurisdiction ? 'true' : undefined}>{getJurisdiction(entry.jurisdiction).name}</a></li>)}
  </ul></nav>
  <p><a class="action-link" href={getSearchUrl({subject:group.id,jurisdiction:land,bereich:'alle'})}>In diesem Sachgebiet suchen</a></p>
  <section aria-labelledby="subject-list-heading"><h2 class="visually-hidden" id="subject-list-heading">Zugeordnete Vorschriften</h2>
    <NormListing basePath={basePath} state={result.state} facets={result.facets} tabCounts={result.tabs.byChangeKind} norms={result.norms} showJurisdiction={!land} jurisdictionName={(id) => getJurisdiction(id).shortName} headingId="subject-list" />
  </section>
</BaseLayout>
