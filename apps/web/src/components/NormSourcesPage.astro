---
/** Quellen und Nachweise: Herkunft der Norm und der gewählten Fassung, verständlich und ohne Speichertechnik. */
import { formatDate, publicNote, VOCABULARY } from '@landesrecht/legal-core/lib/display.ts';
import type { NormView } from '../lib/norm-view.ts';
import NormPageShell from './NormPageShell.astro';
import SourceList from './SourceList.astro';

interface Props {
  view: NormView;
}

const { view } = Astro.props;
const { meta } = view.record;
const jurisdiction = view.jurisdiction.id;
const sourceStatus = view.version.sourceStatus;
const originLabel = view.jurisdiction.sourceSystem.portalLabel;
const versionSources = view.version.sourceReferences ?? [];
const normSources = meta.sourceReferences.filter((source) => !versionSources.some((entry) => entry.label === source.label && entry.url === source.url));
---
<NormPageShell view={view} section="quellen" title={`${VOCABULARY.sections.sources}: ${view.identity.shortTitle} (${view.jurisdiction.shortName})`}>
  <div class="card">
    <h2>Herkunft dieser Fassung</h2>
    <dl class="facts">
      <dt>Fassung</dt><dd>{view.version.simulationValidFrom === view.jurisdiction.baselineDate ? `${VOCABULARY.simulationChange.baselineVersion} vom ${formatDate(view.version.simulationValidFrom)}` : `Fassung vom ${formatDate(view.version.simulationValidFrom)}`}</dd>
      <dt>Fundstelle</dt><dd>{view.version.citation}</dd>
      {(view.version.sourceCitation ?? meta.sourceCitation) && <><dt>Fundstelle der Quelle</dt><dd>{view.version.sourceCitation ?? meta.sourceCitation}</dd></>}
      {meta.originEnactingBody && <><dt>Erlassorgan der Quelle</dt><dd>{meta.originEnactingBody}</dd></>}
      {view.sourceValidityText && <><dt>Geltung der Quellfassung</dt><dd>{view.sourceValidityText.replace(/^Die übernommene Quellfassung galt /u, '')}</dd></>}
    </dl>
    {view.version.simulationValidFrom === view.jurisdiction.baselineDate && (
      <p class="muted">Der Ausgangsrechtsstand wurde aus dem Recht des Landes {view.jurisdiction.sourceSystem.realWorldState} ({originLabel}) übernommen; maßgeblich für die Geltung im Portal ist allein die hier angegebene Gültigkeit.</p>
    )}
    {sourceStatus?.text === 'reconstructed' && (
      <p><strong>Rekonstruierte Fassung:</strong> Der Wortlaut zum {formatDate(view.jurisdiction.baselineDate)} wurde aus späteren amtlichen Fassungen und den dazwischen liegenden Änderungen hergeleitet.{publicNote(sourceStatus.note) && <> {publicNote(sourceStatus.note)}</>}</p>
    )}
    {sourceStatus?.text !== 'reconstructed' && sourceStatus?.validity === 'verified-active-at-baseline' && (
      <p class="muted">Dass diese Fassung am {formatDate(view.jurisdiction.baselineDate)} galt, ist durch amtliche Belege nachgewiesen.{publicNote(sourceStatus.note) && <> {publicNote(sourceStatus.note)}</>}</p>
    )}
    <SourceList sources={versionSources} jurisdiction={jurisdiction} />
  </div>
  {normSources.length > 0 && (
    <div class="card">
      <h2>Weitere Quellen der Vorschrift</h2>
      <SourceList sources={normSources} jurisdiction={jurisdiction} />
    </div>
  )}
</NormPageShell>
