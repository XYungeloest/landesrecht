---
interface Props { normName: string; versionNote?: string; normId: string; versionId: string; versionPath: string }
const { normName, versionNote, normId, versionId, versionPath } = Astro.props;
---
<div class="marking-tools" data-marking-tools data-norm-id={normId} data-version-id={versionId} data-version-path={versionPath} data-norm-name={normName} data-version-note={versionNote} hidden role="region" aria-label="Markierungen im Normtext">
  <div class="marking-tools__bar">
    <span data-marking-count></span>
    <button type="button" class="button-secondary" data-marking-copy="link" aria-label="Link mit allen Markierungen kopieren">Link kopieren</button>
    <button type="button" class="button-secondary" data-marking-manage aria-expanded="false" aria-controls="marking-management">Verwalten</button>
    <button type="button" class="button-secondary marking-tools__clear" data-marking-clear aria-label="Alle Markierungen aufheben" title="Alle Markierungen aufheben"><span aria-hidden="true">×</span></button>
  </div>
  <div id="marking-management" class="marking-tools__panel" data-marking-panel hidden role="region" aria-label="Markierungen verwalten" tabindex="0">
    <button type="button" class="button-secondary" data-marking-copy="citation">Zitat kopieren</button>
    <div data-text-mark-details hidden><div data-text-mark-list></div></div>
  </div>
  <span class="marking-tools__feedback muted" data-marking-feedback role="status" aria-live="polite"></span>
</div>
<div class="text-selection-menu" data-text-selection role="group" aria-label="Textauswahl" hidden>
  <button type="button" class="button-secondary" data-text-marker aria-keyshortcuts="Alt+M" title="Textmarker (Alt+M)">Textmarker</button>
  <button type="button" class="button-secondary" data-selection-copy>Text kopieren</button>
  <p class="muted" data-highlight-fallback hidden>Dieser Browser unterstützt freie Texthervorhebungen nicht. Text kopieren bleibt möglich.</p>
  <span data-selection-feedback role="status" aria-live="polite"></span>
</div>
<script>
  import { initMarkingTools } from '../lib/marking-tools.ts';
  document.querySelectorAll<HTMLElement>('[data-marking-tools]').forEach(initMarkingTools);
</script>
