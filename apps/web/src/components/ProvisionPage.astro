---
import BaseLayout from '../layouts/BaseLayout.astro';
import NormBody from './NormBody.astro';
import ProvisionNavigation from './ProvisionNavigation.astro';
import { buildProvisionNavigation } from '../lib/provision-navigation.ts';
import ReadingControls from './ReadingControls.astro';
import { buildSentencePlan } from '@landesrecht/legal-core/lib/sentences.ts';
import MarkingTools from './MarkingTools.astro';
import MarkingButton from './MarkingButton.astro';
import { getMarkingTargets, formatMarkedCitation } from '@landesrecht/legal-core/lib/markings.ts';
import CopyButton from './CopyButton.astro';
import type { NormView } from '../lib/norm-view.ts';
import type { ProvisionEntry } from '@landesrecht/legal-core/lib/body.ts';
import { getFeedbackUrl, getJurisdictionUrl, getProvisionUrl, getNormSubpageUrl, getNormVersionUrl } from '@landesrecht/legal-core/lib/routes.ts';
interface Props { view: NormView; entry: ProvisionEntry; explicitVersion: boolean }
const { view, entry, explicitVersion } = Astro.props;
const versionId = explicitVersion ? view.version.versionId : undefined;
const navigation = buildProvisionNavigation(view.version.body,view.anchors,view.jurisdiction.id,view.record.meta.slug,entry.anchor,versionId);
const url = getProvisionUrl(view.jurisdiction.id, view.record.meta.slug, entry.anchor, versionId);
const fullUrl = explicitVersion ? view.versionUrl : view.url;
const isLaw = ['gesetz', 'verfassung', 'zustimmungsgesetz'].includes(view.record.meta.type);
const wholeLabel = isLaw ? 'Gesetz' : 'Regelwerk';
const sentences=buildSentencePlan(view.version.body,view.anchors);
const targets = getMarkingTargets(view.version.body, view.anchors);
const markings = new Map(targets.map((target)=>[target.path,target]));
const unitMarking = markings.get(entry.path.join('.'));
const normName = view.identity.abbr || view.identity.shortTitle || view.identity.title;
const versionNote = !view.isCurrent ? `Portal-Fassung: ${view.validityText}` : undefined;
const citationValue = formatMarkedCitation(targets,[entry.anchor],normName,versionNote);
const citation = citationValue || `${entry.block.label ?? ''} ${normName}${versionNote ? ` (${versionNote})` : ''}`.trim();
---
<BaseLayout feedbackPath={getProvisionUrl(view.jurisdiction.id, view.record.meta.slug, entry.anchor, view.version.versionId)} title={`${entry.block.label ?? ''} ${normName} – ${entry.block.title ?? view.identity.shortTitle}`} canonical={url} robots={view.isCurrent ? undefined : 'noindex, follow'}>
  <div class="provision-page" data-marking-document>
    <header class="provision-head">
      <p class="provision-law"><a href={getJurisdictionUrl(view.jurisdiction.id)}>{view.jurisdiction.shortName}</a><span aria-hidden="true"> · </span><a href={fullUrl}>{view.identity.shortTitle}{view.identity.abbr && view.identity.abbr !== view.identity.shortTitle && <> ({view.identity.abbr})</>}</a></p>
      <div class="provision-title"><h1 id={`${entry.anchor}-heading`}>{entry.block.label}{entry.block.title && <> – {entry.block.title}</>}</h1>{unitMarking && <MarkingButton target={unitMarking} />}</div>
      <p class="provision-status" role="note">
        {view.isCurrent ? view.kindLabel : <strong>{view.kindLabel} · {view.validityText}</strong>}
        {view.record.meta.status !== 'in-force' && <> · {view.statusLabel}</>}
        {view.change.kind === 'baseline-changed' && <> · {view.compareUrl ? <a href={view.compareUrl} aria-label={`Vergleich des gesamten ${isLaw ? 'Gesetzes' : 'Regelwerks'}`}>{wholeLabel} in der Simulation geändert</a> : <span>{wholeLabel} in der Simulation geändert</span>}</>}
        {view.change.kind === 'simulation-new' && <> · {wholeLabel} in der Simulation neu geschaffen</>}
      </p>
      <div class="provision-actions">
        <a href={getFeedbackUrl(getProvisionUrl(view.jurisdiction.id, view.record.meta.slug, entry.anchor, view.version.versionId))}>Fehler melden</a>
        <a href={`${fullUrl}#${entry.anchor}`}>{isLaw ? 'Ganzes Gesetz' : 'Ganzes Regelwerk'}</a>
        {citationValue && <CopyButton value={citationValue} label="Zitat kopieren" />}
        {view.versions.length > 1 && <a href={getNormSubpageUrl(view.jurisdiction.id,view.record.meta.slug,'historie')}>Fassungen</a>}
        <ReadingControls />
      </div>
    </header>
    <ProvisionNavigation model={navigation} position="top" />
    <article class="norm-document" aria-label={citation}>
      <NormBody sentences={sentences} markings={markings} blocks={[entry.block]} anchors={view.anchors} path={entry.path.slice(0, -1)} indexOffset={entry.path.at(-1)} jurisdiction={view.jurisdiction.id} headingLevel={1} single rootHeadingId={`${entry.anchor}-heading`} />
    </article>
    <ProvisionNavigation model={navigation} position="bottom" />
    <details class="provision-details">
      <summary>Weitere Angaben</summary>
      <dl class="facts"><dt>Vorschrift</dt><dd>{view.identity.title}{view.identity.abbr && <> ({view.identity.abbr})</>}</dd><dt>Geltung</dt><dd>{view.statusLabel}</dd><dt>Fassung</dt><dd>{view.legalStatusText} · {view.validityText}</dd><dt>Fundstelle</dt><dd>{view.version.citation}</dd></dl>
      {view.change.kind === 'baseline-changed' && <p>Die Änderungsangabe bezieht sich auf das gesamte {wholeLabel}. Eine Änderung dieser Einzelvorschrift wird damit nicht ausgewiesen.</p>}
      <div class="provision-more-actions">
        <CopyButton value={new URL(url, import.meta.env.PUBLIC_SITE_URL ?? Astro.site ?? Astro.url.origin).href} label="Link kopieren" />
        <a href={`#${entry.anchor}`}>Direktlink zur Vorschrift</a>
        <a href={getNormSubpageUrl(view.jurisdiction.id,view.record.meta.slug,'daten',versionId)}>Vorschriftendaten</a>
        <a href={getNormSubpageUrl(view.jurisdiction.id,view.record.meta.slug,'quellen',versionId)}>Quellen und Nachweise</a>
        {view.baselineVersion && view.baselineVersion.versionId !== view.version.versionId && <a href={getNormVersionUrl(view.jurisdiction.id,view.record.meta.slug,view.baselineVersion.versionId)}>Ausgangsfassung des {isLaw ? 'Gesetzes' : 'Regelwerks'}</a>}
        {view.compareUrl && <a href={view.compareUrl}>Vergleich des gesamten {isLaw ? 'Gesetzes' : 'Regelwerks'}</a>}
      </div>
    </details>
    <MarkingTools normId={view.record.meta.id} versionId={view.version.versionId} versionPath={getProvisionUrl(view.jurisdiction.id,view.record.meta.slug,entry.anchor,view.version.versionId)} normName={normName} versionNote={versionNote} />
  </div>
</BaseLayout>
