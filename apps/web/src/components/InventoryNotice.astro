---
/**
 * Knapper fachlicher Hinweis zum Rechtsbestand eines Landes: Ausgangspunkt ist der Rechtsstand vom Ausgangsrechtsstand,
 * spätere Änderungen stammen aus der Simulation; sind Quellen noch nicht vollständig erschlossen, ein Satz dazu.
 * Kennzahlen, Prüfstände und Arbeitsbegriffe gehören nicht auf öffentliche Seiten – Einzelheiten stehen auf der
 * Informationsseite `/ueber-den-rechtsbestand/`. Die Daten kommen aus `inventory-status.json` (nur zur Entscheidung,
 * ob der Quellenhinweis nötig ist).
 */
import { getInventoryNotice } from '@landesrecht/legal-core/config/inventory-status.ts';
import { formatBaselineDate, getJurisdiction, type JurisdictionId } from '@landesrecht/legal-core/config/jurisdictions.ts';
import { PORTAL_PATHS } from '@landesrecht/legal-core/lib/routes.ts';

interface Props {
  jurisdiction: JurisdictionId;
}

const { jurisdiction } = Astro.props;
const notice = getInventoryNotice(jurisdiction);
const baselineDate = formatBaselineDate(getJurisdiction(jurisdiction).baselineDate);
const sourcesIncomplete = notice !== undefined && (notice.baselinePartial || notice.simulationPartial);
---
<aside class="inventory-notice" aria-label="Hinweis zum Rechtsbestand">
  <p>Ausgangspunkt der Simulation ist der Rechtsstand vom {baselineDate}. Änderungen danach stammen aus der Politiksimulation.{sourcesIncomplete && <> Einzelne historische oder veröffentlichte Quellen sind noch nicht vollständig erschlossen.</>} <a href={PORTAL_PATHS.about}>Mehr zum Rechtsbestand</a></p>
</aside>
