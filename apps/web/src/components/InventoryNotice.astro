---
/**
 * Hinweis zum Bestand eines Landes: „Teilbestand“, solange der Stichtagsbestand nicht vollständig veröffentlicht
 * ist, und der Stand der Simulationsrechtsfortschreibung (Rechtsakte, Ausgaben, Prüfung, Quellensammlung). Die
 * Ein eingefrorener Ausgangsrechtsstand (`baselineFreeze.frozen`) wird als solcher gekennzeichnet, ohne nicht belegte
 * Stichtagsnormen oder Sim-Verkündungen als vollständig auszugeben. Zahlen stammen aus `@landesrecht/legal-core/config/inventory-status.json` (von Importer und
 * `import-simulation completeness --write` erzeugt). Meldet die Datei den Stichtagsbestand als vollständig und den
 * Simulationsstand als `SIM LEGAL STATE COMPLETE`, verschwindet der Hinweis ohne Codeänderung. Baseline-Normzahl
 * (`published`) und Sim-Normzahl (`simulation.simulationNorms`) werden getrennt ausgewiesen.
 */
import { getInventoryNotice, type SimulationInventoryStatus } from '@landesrecht/legal-core/config/inventory-status.ts';
import { formatBaselineDate, getJurisdiction, type JurisdictionId } from '@landesrecht/legal-core/config/jurisdictions.ts';

interface Props {
  jurisdiction: JurisdictionId;
  /** `badge`: nur die Kennzeichnung (Übersichten); `full`: Kennzeichnung mit Zahlen (Länderseite, Suche). */
  variant?: 'badge' | 'full';
}

const { jurisdiction, variant = 'full' } = Astro.props;
const notice = getInventoryNotice(jurisdiction);
const status = notice?.entry;
const simulation = status?.simulation;
const number = new Intl.NumberFormat('de-DE');
const outstanding = status ? status.pending.atBaseline + status.pending.baselineOnly : 0;
const shortName = getJurisdiction(jurisdiction).shortName;
const plural = (value: number, one: string, many: string): string => `${number.format(value)} ${value === 1 ? one : many}`;

/** Baseline-Status: eingefroren oder – solange nicht – die bewertete Bereitschaft (getrennt vom Sim-Quellenstatus). */
function freezeText(): string | undefined {
  const freeze = status?.baselineFreeze;
  if (!freeze) return undefined;
  if (freeze.frozen) return 'Der veröffentlichte Ausgangsrechtsstand ist eingefroren (Änderungen nur mit dokumentierter Entscheidung).';
  const readiness = freeze.readiness === 'BASELINE READY' ? 'bereit' : freeze.readiness === 'READY WITH HUMAN REVIEW' ? 'bereit nach fachlicher Prüfung offener Fälle' : 'noch nicht bereit (technische Klärungen offen)';
  return `Ausgangsrechtsstand nicht eingefroren; Freeze-Bewertung: ${readiness}, Stand ${freeze.assessedAt}.`;
}

function sourcesText(entry: SimulationInventoryStatus): string {
  if (entry.status === 'SIM SOURCES PARTIAL') return `Quellensammlung unvollständig: ${number.format(entry.presentIssues)} von ${number.format(entry.knownIssues)} bekannten Ausgaben liegen vor; der Rechtsstand nach dem Stichtag kann Lücken haben.`;
  if (entry.status === 'SIM SOURCES COMPLETE FOR KNOWN INVENTORY') return `Quellensammlung vollständig für das bekannte Inventar (${plural(entry.presentIssues, 'Ausgabe', 'Ausgaben')}); der Rechtsstand wird noch geprüft.`;
  return 'Simulationsrechtsstand vollständig belegt.';
}
const frozen = status?.baselineFreeze?.frozen === true;
const badgeTitle = notice?.baselinePartial
  ? frozen
    ? `${shortName}: eingefrorener Ausgangsrechtsstand – nicht jede am Stichtag geltende Norm ist belegt und veröffentlicht`
    : `${shortName}: Teilbestand – weitere Normen zum Stichtag werden ergänzt`
  : `${shortName}: Simulationsrecht noch nicht vollständig belegt`;
---
{notice && variant === 'badge' && <span class="tag tag--partial" title={badgeTitle}>Teilbestand</span>}
{notice && status && variant === 'full' && (
  <aside class="inventory-notice" aria-label={`Hinweis zum Bestand ${shortName}`}>
    {notice.baselinePartial && frozen ? (
      <p>
        <strong>Baseline-Status: eingefrorener Ausgangsrechtsstand.</strong> Veröffentlicht sind {number.format(status.published)} Normen, deren Fassung vom {formatBaselineDate(status.baselineDate)} aus amtlichen Quellen belegt ist; dieser Bestand ist eingefroren (Änderungen nur mit dokumentierter Entscheidung).
        {outstanding > 0 && <> Weitere {number.format(outstanding)} Normen, die an diesem Tag galten, sind nicht veröffentlicht, weil ihre Stichtagsfassung nicht sicher belegt ist; der Freeze bestätigt sie weder als vollständig noch als richtig.</>}
      </p>
    ) : notice.baselinePartial ? (
      <p>
        <strong>Baseline-Status: Teilbestand.</strong> Veröffentlicht sind {number.format(status.published)} Normen, deren Fassung vom {formatBaselineDate(status.baselineDate)} aus amtlichen Quellen belegt ist.
        {outstanding > 0 && <> Für weitere {number.format(outstanding)} Normen, die an diesem Tag galten, wird die Stichtagsfassung noch nachgewiesen; sie werden danach ergänzt.</>}
        {freezeText() && <> {freezeText()}</>}
      </p>
    ) : (
      <p><strong>Baseline-Status: Sicher belegter Rechtsstand zum {formatBaselineDate(status.baselineDate)}:</strong> {number.format(status.published)} Normen aus amtlichen Quellen.{freezeText() && <> {freezeText()}</>}</p>
    )}
    {simulation && (
      <p>
        <strong>Sim-Quellenstatus – Simulationsrecht:</strong> {plural(simulation.secureActs, 'Rechtsakt', 'Rechtsakte')} aus {plural(simulation.presentIssues, 'Ausgabe', 'Ausgaben')} übernommen ({plural(simulation.simulationNorms, 'eigene Norm der Simulation', 'eigene Normen der Simulation')}), {number.format(simulation.review)} in Prüfung{simulation.draftsWithoutPromulgation > 0 && <>, {plural(simulation.draftsWithoutPromulgation, 'Entwurf ohne Verkündungsbeleg', 'Entwürfe ohne Verkündungsbeleg')}</>}; {sourcesText(simulation)} <span class="muted">Stand {simulation.updatedAt}.</span>
      </p>
    )}
  </aside>
)}
