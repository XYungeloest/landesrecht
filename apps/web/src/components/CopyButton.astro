---
/**
 * „Kopieren“-Schaltfläche mit Rückmeldung (progressiv: ohne JavaScript bleibt der Wert als Text sichtbar und markierbar).
 * Verwendet die Zwischenablage-API des Browsers; die Rückmeldung wird per `aria-live` vorgelesen.
 */
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---
<span class="copy-action" data-copy-action>
  <button type="button" class="button-secondary copy-action__button" data-copy-value={value} hidden>{label}</button>
  <noscript><span class="muted">{label}: <code>{value}</code></span></noscript>
  <span class="copy-action__feedback muted" aria-live="polite"></span>
</span>
<script>
  import { copyText } from '../lib/copy.ts';
  for (const container of document.querySelectorAll<HTMLElement>('[data-copy-action]')) {
    const button = container.querySelector<HTMLButtonElement>('button[data-copy-value]');
    const feedback = container.querySelector<HTMLElement>('.copy-action__feedback');
    if (!button || !feedback) continue;
    button.hidden = false;
    button.addEventListener('click', async () => {
      await copyText(button.dataset.copyValue ?? '', feedback);
    });
  }
</script>
