---
import ResponsiveDisclosure from './ResponsiveDisclosure.astro';
import type { OutlineEntry } from '@landesrecht/legal-core/lib/body.ts';

interface Props {
  entries: OutlineEntry[];
  root?: boolean;
}

const { entries, root = true } = Astro.props;
---
{root ? (
  <nav class="norm-outline" aria-label="Inhaltsübersicht">
    <ResponsiveDisclosure label="Inhaltsübersicht">
    <ol>
      {entries.map((entry) => (
        <li>
          <a href={`#${entry.anchor}`}>{[entry.label, entry.title].filter(Boolean).join(' ')}</a>
          {entry.children.length > 0 && <Astro.self entries={entry.children} root={false} />}
        </li>
      ))}
    </ol>
    </ResponsiveDisclosure>
  </nav>
) : (
  <ol>
    {entries.map((entry) => (
      <li>
        <a href={`#${entry.anchor}`}>{[entry.label, entry.title].filter(Boolean).join(' ')}</a>
        {entry.children.length > 0 && <Astro.self entries={entry.children} root={false} />}
      </li>
    ))}
  </ol>
)}

<script>
  const outline = document.querySelector('.norm-outline');
  const links = outline?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]');
  const updateCurrent = () => {
    links?.forEach((link) => {
      if (link.hash === window.location.hash) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };
  window.addEventListener('hashchange', updateCurrent);
  updateCurrent();
</script>
