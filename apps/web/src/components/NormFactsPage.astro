---
/**
 * Vorschriftendaten für Leserinnen und Leser: Bezeichnung, Normtyp, Geltung, Land, Daten, Fundstelle, Organe,
 * Sachgebiete und Beziehungen. Technische Angaben (Geltungsintervalle der Quellfassung, Quellenlage-Codes,
 * Systemkennungen, Kennungen) stehen nicht hier; rechtlich relevante Herkunft steht unter „Quellen und Nachweise“.
 */
import { getJurisdiction } from '@landesrecht/legal-core/config/jurisdictions.ts';
import { formatDate, publicNote, simulationChangeDateText, simulationChangeLabel, VOCABULARY } from '@landesrecht/legal-core/lib/display.ts';
import { resolveRelationNote } from '@landesrecht/legal-core/lib/editorial-resolutions.ts';
import { getNormUrl } from '@landesrecht/legal-core/lib/routes.ts';
import type { NormView } from '../lib/norm-view.ts';
import { relationTargetKey, type RelationTargetInfo, type RelationTargetState } from '../lib/relation-targets.ts';
import NormPageShell from './NormPageShell.astro';

interface Props {
  view: NormView;
  /** Existenz der Beziehungsziele (`resolveRelationTargets`); fehlt die Angabe, wird wie bisher verlinkt. */
  relationTargets?: Map<string, RelationTargetInfo>;
}

const { view, relationTargets } = Astro.props;
/** Verlinkt nur vorhandene Ziele; ein nicht vorhandenes Ziel erscheint als Text mit Status statt als toter Link. */
const targetState = (jurisdiction: string, slug: string): RelationTargetState => relationTargets?.get(relationTargetKey(jurisdiction, slug))?.state ?? 'present';
/** Anzeigename eines Ziels: angegebene Bezeichnung oder Titel der Zielnorm; ohne beides nie die technische Adresse. */
const targetName = (jurisdiction: string, slug: string, fallback?: string | null): string => fallback ?? relationTargets?.get(relationTargetKey(jurisdiction, slug))?.title ?? 'eine noch nicht erfasste Vorschrift';
const ABSENT_TARGET = VOCABULARY.simulationChange.notConsolidated;
const { meta } = view.record;
const RELATION_LABELS: Record<string, string> = {
  amends: 'ändert', 'amended-by': 'geändert durch', repeals: 'hebt auf', 'repealed-by': 'aufgehoben durch', replaces: 'ersetzt', 'replaced-by': 'ersetzt durch',
  implements: 'führt aus', 'based-on': 'beruht auf', 'part-of': 'Bestandteil von', contains: 'enthält', 'refers-to': 'verweist auf', related: 'verwandt', corrects: 'berichtigt', 'corrected-by': 'berichtigt durch',
};
const changeNote = publicNote(view.version.changeNote);
const standText = view.change.kind === 'baseline-unchanged' ? `${simulationChangeLabel('baseline-unchanged')} (${formatDate(view.jurisdiction.baselineDate)})` : view.change.kind === 'baseline-changed' ? `${simulationChangeLabel('baseline-changed')}${view.change.lastChangeDate ? `, ${simulationChangeDateText(view.change.lastChangeDate)}` : ''}` : `${simulationChangeLabel('simulation-new')}${view.change.firstSimulationDate ? ` (seit ${formatDate(view.change.firstSimulationDate)})` : ''}`;
---
<NormPageShell view={view} section="daten" title={`${VOCABULARY.sections.facts}: ${view.identity.shortTitle} (${view.jurisdiction.shortName})`}>
  <div class="card">
    <h2>{VOCABULARY.sections.facts}</h2>
    <dl class="facts">
      <dt>Titel</dt><dd>{view.identity.title}</dd>
      <dt>Kurzbezeichnung</dt><dd>{view.identity.shortTitle}</dd>
      <dt>Abkürzung</dt><dd>{view.identity.abbr ?? '–'}</dd>
      <dt>Normtyp</dt><dd>{view.typeLabel}</dd>
      <dt>{VOCABULARY.validity.label}</dt><dd>{view.statusLabel}</dd>
      <dt>{VOCABULARY.simulationChange.label}</dt><dd>{standText}</dd>
      <dt>Land</dt><dd>{view.jurisdiction.name} ({view.jurisdiction.shortName})</dd>
      <dt>Ausfertigung oder Erlass</dt><dd>{formatDate(meta.documentDate)}</dd>
      <dt>Verkündung</dt><dd>{formatDate(meta.publicationDate)}</dd>
      <dt>Inkrafttreten</dt><dd>{formatDate(meta.effectiveDate)}</dd>
      <dt>Außerkrafttreten</dt><dd>{formatDate(meta.expiryDate)}</dd>
      <dt>Fundstelle</dt><dd>{view.version.citation}</dd>
      {meta.initialCitation !== view.version.citation && <><dt>Fundstelle der Stammfassung</dt><dd>{meta.initialCitation}</dd></>}
      <dt>Erlassorgan</dt><dd>{meta.enactingBody ?? meta.originEnactingBody ?? 'nicht angegeben'}</dd>
      <dt>Zuständige Stelle</dt><dd>{meta.responsibleBody ?? '–'}</dd>
      {meta.subjects.length > 0 && <><dt>Sachgebiete</dt><dd>{meta.subjects.join(', ')}</dd></>}
      {meta.keywords.length > 0 && <><dt>Schlagwörter</dt><dd>{meta.keywords.join(', ')}</dd></>}
      {(meta.predecessor || meta.predecessorTarget) && <><dt>Vorgänger</dt><dd>{meta.predecessorTarget && targetState(meta.predecessorTarget.jurisdiction ?? meta.jurisdiction, meta.predecessorTarget.slug) === 'present' ? <a href={getNormUrl(meta.predecessorTarget.jurisdiction ?? meta.jurisdiction, meta.predecessorTarget.slug)}>{targetName(meta.predecessorTarget.jurisdiction ?? meta.jurisdiction, meta.predecessorTarget.slug, meta.predecessor)}</a> : meta.predecessorTarget ? <>{targetName(meta.predecessorTarget.jurisdiction ?? meta.jurisdiction, meta.predecessorTarget.slug, meta.predecessor)} <span class="muted">({ABSENT_TARGET})</span></> : meta.predecessor}</dd></>}
      {(meta.successor || meta.successorTarget) && <><dt>Nachfolger</dt><dd>{meta.successorTarget && targetState(meta.successorTarget.jurisdiction ?? meta.jurisdiction, meta.successorTarget.slug) === 'present' ? <a href={getNormUrl(meta.successorTarget.jurisdiction ?? meta.jurisdiction, meta.successorTarget.slug)}>{targetName(meta.successorTarget.jurisdiction ?? meta.jurisdiction, meta.successorTarget.slug, meta.successor)}</a> : meta.successorTarget ? <>{targetName(meta.successorTarget.jurisdiction ?? meta.jurisdiction, meta.successorTarget.slug, meta.successor)} <span class="muted">({ABSENT_TARGET})</span></> : meta.successor}</dd></>}
    </dl>
  </div>
  <div class="card">
    <h2>Diese Fassung</h2>
    <dl class="facts">
      <dt>Gültig ab</dt><dd>{formatDate(view.version.simulationValidFrom)}</dd>
      <dt>Gültig bis</dt><dd>{view.version.simulationValidTo ? formatDate(view.version.simulationValidTo) : 'bis auf Weiteres'}</dd>
      {changeNote && <><dt>Änderungshinweis</dt><dd>{changeNote}</dd></>}
    </dl>
    <p class="muted">Herkunft und Belege dieser Fassung: <a href={view.subpages.find((subpage) => subpage.key === 'quellen')?.url}>{VOCABULARY.sections.sources}</a>.</p>
  </div>
  <div class="card">
    <h2>Beziehungen</h2>
    {meta.relations.length === 0 ? <p class="muted">Keine Beziehungen hinterlegt.</p> : (
      <ul>
        {meta.relations.map((relation) => {
          const jurisdiction = relation.target.jurisdiction ?? meta.jurisdiction;
          const note = publicNote(resolveRelationNote(meta, relation).note);
          return (
            <li>
              {RELATION_LABELS[relation.type] ?? relation.type}: {targetState(jurisdiction, relation.target.slug) === 'present' ? <a href={getNormUrl(jurisdiction, relation.target.slug)}>{targetName(jurisdiction, relation.target.slug)}</a> : <>{targetName(jurisdiction, relation.target.slug)} <span class="muted">– {ABSENT_TARGET}</span></>}
              <span class="muted"> ({getJurisdiction(jurisdiction).shortName}{note ? `, ${note}` : ''}{relation.date ? `, ${formatDate(relation.date)}` : ''})</span>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</NormPageShell>
