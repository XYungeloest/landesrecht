---
/** Fassungsnavigation, Zitat und Quellenüberblick einer Normansicht. */
import { formatDate, VOCABULARY } from '@landesrecht/legal-core/lib/display.ts';
import type { NormView } from '../lib/norm-view.ts';
import SourceList from './SourceList.astro';

interface Props {
  view: NormView;
}

const { view } = Astro.props;
const sources = [...(view.version.sourceReferences ?? []), ...view.record.meta.sourceReferences.filter((source) => !(view.version.sourceReferences ?? []).some((entry) => entry.label === source.label && entry.url === source.url))];
const siteUrl = import.meta.env.PUBLIC_SITE_URL;
---
<aside class="norm-aside">
  <section aria-labelledby="fassungen-heading">
    <h2 id="fassungen-heading">{VOCABULARY.sections.history}</h2>
    <ul class="timeline">
      {view.versions.map((entry) => (
        <li aria-current={entry.selected ? 'true' : undefined}>
          <a href={entry.url}>{entry.simulationValidFrom === view.jurisdiction.baselineDate ? `${VOCABULARY.simulationChange.baselineVersion} (${formatDate(entry.simulationValidFrom)})` : `Änderung am ${formatDate(entry.simulationValidFrom)}`}</a>
          {entry.kind === 'current' && <span class="tag tag--current">{VOCABULARY.simulationChange.currentVersion}</span>}
          {entry.kind === 'future' && <span class="tag tag--future">{entry.kindLabel}</span>}
          {entry.simulationValidTo && <span class="muted"> bis {formatDate(entry.simulationValidTo)}</span>}
        </li>
      ))}
    </ul>
    <p><a href={view.subpages.find((subpage) => subpage.key === 'historie')?.url}>{VOCABULARY.simulationChange.changesSince}</a>{view.compareUrl && <> · <a href={view.compareUrl}>{VOCABULARY.simulationChange.compareCta}</a></>}</p>
  </section>
  <section aria-labelledby="zitieren-heading">
    <h2 id="zitieren-heading">Zitieren</h2>
    <p>{view.identity.abbr ?? view.identity.shortTitle} ({view.jurisdiction.shortName}), {view.version.citation}</p>
    <p class="muted">{view.isCurrent ? 'Der allgemeine Link führt stets zur geltenden Fassung.' : 'Der Fassungslink führt dauerhaft zu dieser Fassung.'}</p>
    <p><a href={view.isCurrent ? view.url : view.versionUrl}>{siteUrl}{view.isCurrent ? view.url : view.versionUrl}</a></p>
  </section>
  <section aria-labelledby="quellen-heading">
    <h2 id="quellen-heading">{VOCABULARY.sections.sources}</h2>
    <SourceList sources={sources} compact={true} jurisdiction={view.jurisdiction.id} />
    <p><a href={view.subpages.find((subpage) => subpage.key === 'quellen')?.url}>Alle Quellen und Nachweise</a></p>
  </section>
</aside>
