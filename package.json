{
  "name": "landesrecht-portal",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Gemeinsames Landesrechtsportal der vier Länder der politischen Simulation (West, NSH, Ost, BayWü).",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/importers/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run d1:seed:dev && npm run dev --workspace @landesrecht/web",
    "preview": "npm run preview --workspace @landesrecht/web",
    "check": "npm run check:types && npm run check:web",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "check:web": "npm run check --workspace @landesrecht/web",
    "test": "vitest run --reporter=default --reporter=junit --outputFile=test-results/junit.xml",
    "test:watch": "vitest",
    "test:search": "vitest run tests/unit/search-*.test.ts",
    "test:d1": "vitest run tests/unit/d1-*.test.ts tests/unit/runtime-*.test.ts",
    "build": "npm run build --workspace @landesrecht/web",
    "content:validate": "node scripts/validate-content.ts",
    "content:check": "npm run content:validate && npm run content:immutability",
    "d1:schema:check": "node scripts/d1-schema-check.ts",
    "d1:project": "node scripts/project-d1.ts",
    "d1:project:local": "node scripts/project-d1.ts --target local",
    "d1:seed:local": "node scripts/project-d1.ts --target local --reset",
    "d1:apply:remote": "node scripts/project-d1.ts --target remote-plan",
    "deploy": "npm run deploy --workspace @landesrecht/web",
    "content:immutability": "node scripts/check-version-immutability.ts",
    "d1:seed:dev": "node scripts/seed-dev-d1.ts",
    "import:recht-nrw": "node scripts/import-recht-nrw.ts import",
    "import:recht-nrw:inspect": "node scripts/import-recht-nrw.ts inspect",
    "import:recht-nrw:sample": "node scripts/import-recht-nrw.ts sample",
    "import:recht-nrw:audit": "node scripts/import-recht-nrw.ts audit",
    "import:recht-nrw:lrgv:sample": "node scripts/import-recht-nrw.ts sample --area lrgv",
    "import:recht-nrw:lrmb": "node scripts/import-recht-nrw.ts import --area lrmb",
    "import:recht-nrw:lrmb:inspect": "node scripts/import-recht-nrw.ts inspect --area lrmb",
    "import:recht-nrw:lrmb:sample": "node scripts/import-recht-nrw.ts sample --area lrmb",
    "import:recht-nrw:coverage": "node scripts/import-recht-nrw.ts coverage",
    "import:recht-nrw:review": "node scripts/import-recht-nrw.ts review",
    "import:recht-nrw:enumerate": "node scripts/import-recht-nrw.ts enumerate",
    "import:recht-nrw:bulk": "node scripts/import-recht-nrw.ts bulk",
    "import:recht-nrw:r2-sync": "node scripts/import-recht-nrw.ts r2-sync",
    "import:recht-nrw:readiness": "node scripts/import-recht-nrw.ts readiness",
    "import:recht-nrw:search-audit": "node scripts/import-recht-nrw.ts search-audit",
    "import:recht-nrw:reconstruction-queue": "node scripts/import-recht-nrw.ts reconstruction-queue",
    "import:recht-nrw:review-report": "node scripts/import-recht-nrw.ts review-report",
    "import:recht-nrw:approval-report": "node scripts/import-recht-nrw.ts approval-report",
    "import:recht-nrw:approval": "node scripts/import-recht-nrw.ts approval",
    "import:recht-nrw:approval-status": "node scripts/import-recht-nrw.ts approval-status",
    "import:recht-nrw:simulate": "node scripts/bulk-simulation.ts",
    "import:juris-sh": "node scripts/import-juris-sh.ts help",
    "import:juris-sh:enumerate": "node scripts/import-juris-sh.ts enumerate",
    "import:juris-sh:sample": "node scripts/import-juris-sh.ts sample",
    "import:juris-sh:bulk": "node scripts/import-juris-sh.ts bulk",
    "import:juris-sh:audit": "node scripts/import-juris-sh.ts audit",
    "import:juris-sh:coverage": "node scripts/import-juris-sh.ts coverage",
    "import:juris-sh:review": "node scripts/import-juris-sh.ts review",
    "import:juris-sh:readiness": "node scripts/import-juris-sh.ts readiness",
    "import:juris-sh:search-audit": "node scripts/import-juris-sh.ts search-audit",
    "import:juris-sh:reconstruction-queue": "node scripts/import-juris-sh.ts reconstruction-queue",
    "import:juris-sh:r2-sync": "node scripts/import-juris-sh.ts r2-sync",
    "import:juris-sh:events": "node scripts/import-juris-sh.ts events",
    "import:bayernrecht": "node scripts/import-bayernrecht.ts help",
    "import:bayernrecht:enumerate": "node scripts/import-bayernrecht.ts enumerate",
    "import:bayernrecht:sample": "node scripts/import-bayernrecht.ts sample",
    "import:bayernrecht:bulk": "node scripts/import-bayernrecht.ts bulk",
    "import:bayernrecht:audit": "node scripts/import-bayernrecht.ts audit",
    "import:bayernrecht:coverage": "node scripts/import-bayernrecht.ts coverage",
    "import:bayernrecht:review": "node scripts/import-bayernrecht.ts review",
    "import:bayernrecht:readiness": "node scripts/import-bayernrecht.ts readiness",
    "import:bayernrecht:search-audit": "node scripts/import-bayernrecht.ts search-audit",
    "import:bayernrecht:reconstruction-queue": "node scripts/import-bayernrecht.ts reconstruction-queue",
    "import:bayernrecht:r2-sync": "node scripts/import-bayernrecht.ts r2-sync",
    "import:bayernrecht:events": "node scripts/import-bayernrecht.ts events",
    "d1:plan": "node scripts/project-d1.ts --target remote-batches",
    "d1:apply:batches": "node scripts/d1-apply-batches.ts",
    "d1:scale-test": "node scripts/d1-scale-test.ts",
    "audit:r2": "node scripts/r2-audit.ts",
    "audit:d1-remote": "node scripts/d1-remote-check.ts",
    "audit:performance": "node scripts/perf-baseline.ts",
    "audit:provenance": "node scripts/audit-provenance.ts",
    "audit:naming": "node scripts/audit-naming.ts",
    "audit:large-norms": "node scripts/audit-large-norms.ts",
    "audit:anchors": "node scripts/audit-anchors.ts",
    "audit:treaty-evidence": "node scripts/audit-treaty-evidence.ts",
    "audit:reconstruction": "node scripts/audit-reconstruction.ts",
    "audit:external-urls": "node scripts/audit-external-urls.ts",
    "audit:site": "node scripts/audit-site.ts",
    "audit:consent-laws": "node scripts/audit-consent-laws.ts",
    "audit:residuals": "node scripts/audit-residuals.ts",
    "audit:legacy-structure": "node scripts/audit-legacy-structure.ts",
    "audit:quality": "npm run -s audit:provenance && npm run -s audit:naming && npm run -s audit:large-norms && npm run -s audit:anchors && npm run -s audit:treaty-evidence && npm run -s audit:reconstruction && npm run -s audit:consent-laws && npm run -s audit:residuals && npm run -s audit:legacy-structure"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
