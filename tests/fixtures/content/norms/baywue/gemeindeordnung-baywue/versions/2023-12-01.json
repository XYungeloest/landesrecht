  "sourceValidFrom": "2023-01-01",
  "citation": "Gemeindeordnung in der Fassung der Bekanntmachung vom 22. August 1998 (GVBl. BayWü S. 796)",
  "changeNote": "Ausgangsfassung zum Ausgangsrechtsstand 2023-12-01.",
  "body": [
    {
      "type": "part",
      "label": "Erster Teil",
      "title": "Wesen und Aufgaben der Gemeinden",
      "children": [
        {
          "type": "article",
          "label": "Art. 1",
          "title": "Rechtsstellung",
          "children": [
            { "type": "paragraphText", "text": "Die Gemeinden sind ursprüngliche Gebietskörperschaften mit dem Recht, die örtlichen Angelegenheiten im Rahmen der Gesetze selbst zu ordnen und zu verwalten." }
          ]
        },
        {
          "type": "article",
          "label": "Art. 5",
          "title": "Gemeinderat",
          "children": [
            { "type": "subparagraph", "label": "(1)", "text": "Der Gemeinderat besteht aus dem ersten Bürgermeister und den Gemeinderatsmitgliedern.", "children": [] },
            { "type": "subparagraph", "label": "(2)", "text": "Die Zahl der Gemeinderatsmitglieder richtet sich nach der Einwohnerzahl der Gemeinde.", "children": [] }
          ]
        }
      ]
    },
    {
      "type": "part",
      "label": "Zweiter Teil",
      "title": "Schlussvorschriften",
      "children": [
        {
          "type": "article",
          "label": "Art. 127",
          "title": "Inkrafttreten",
          "children": [
            { "type": "paragraphText", "text": "Dieses Gesetz tritt am Tag nach seiner Bekanntmachung in Kraft." }
          ]
        }
      ]
    }
  ]
}
