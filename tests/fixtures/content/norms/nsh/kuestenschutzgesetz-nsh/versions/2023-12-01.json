  "citation": "Küstenschutzgesetz vom 3. März 2010 (GVOBl. NSH S. 45)",
  "changeNote": "Ausgangsfassung zum Ausgangsrechtsstand 2023-12-01.",
  "body": [
    {
      "type": "section",
      "label": "Abschnitt 1",
      "title": "Deichschutz",
      "children": [
        {
          "type": "paragraph",
          "label": "§ 1",
          "title": "Zweck des Gesetzes",
          "children": [
            { "type": "paragraphText", "text": "Dieses Gesetz dient dem Schutz der Küsten und des Hinterlandes vor Sturmfluten und Landverlust." }
          ]
        },
        {
          "type": "paragraph",
          "label": "§ 2",
          "title": "Deichpflicht",
          "children": [
            { "type": "subparagraph", "label": "(1)", "text": "Landesschutzdeiche werden vom Land unterhalten.", "children": [] },
            { "type": "subparagraph", "label": "(2)", "text": "Regionaldeiche werden von den Deichverbänden unterhalten; das Land kann Zuschüsse gewähren.", "children": [] }
          ]
        }
      ]
    },
    {
      "type": "section",
      "label": "Abschnitt 2",
      "title": "Schlussvorschriften",
      "children": [
        {
          "type": "paragraph",
          "label": "§ 9",
          "title": "Inkrafttreten",
          "children": [
            { "type": "paragraphText", "text": "Dieses Gesetz tritt am 1. April 2010 in Kraft." }
          ]
        }
      ]
    }
  ]
}
