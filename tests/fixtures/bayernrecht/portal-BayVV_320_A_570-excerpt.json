   "title": "Zahl der Kammern bei den Landesarbeitsgerichten",
   "children": [
    {
     "type": "paragraphText",
     "text": "Aufgrund des § 35 Abs. 3 des Arbeitsgerichtsgesetzes (ArbGG) wird die Zahl der Kammern bei den Landesarbeitsgerichten wie folgt festgesetzt:"
    },
    {
     "type": "table",
     "children": [
      {
       "type": "tableRow",
       "children": [
        {
         "type": "tableCell",
         "text": "a)\nLandesarbeitsgericht München:"
        },
        {
         "type": "tableCell",
         "text": "13 Kammern"
        }
       ]
      },
      {
       "type": "tableRow",
       "children": [
        {
         "type": "tableCell",
         "text": "b)\nLandesarbeitsgericht Nürnberg:"
        },
        {
         "type": "tableCell",
         "text": "10 Kammern"
        }
       ]
      }
     ],
     "columns": 2
    }
