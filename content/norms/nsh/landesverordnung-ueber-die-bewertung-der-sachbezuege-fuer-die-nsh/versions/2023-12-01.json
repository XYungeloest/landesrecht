            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "c) im Feldanbau gewonnenes Heu (Acker-, Luzerne-,"
                },
                {
                  "type": "tableCell",
                  "text": "für 50 kg 6,10 DM"
                }
              ]
            }
          ]
        },
        {
          "type": "paragraphText",
          "text": "Kleeheu)"
        },
        {
          "type": "paragraphText",
          "text": "16. Kartoffel- oder Gartenland"
        },
        {
          "type": "table",
          "columns": 2,
          "children": [
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "a) bearbeitet und gedüngt"
                },
                {
                  "type": "tableCell",
                  "text": "für 0,25 ha jährlich 190,00 DM"
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "b) unbearbeitet und ungedüngt"
                },
                {
                  "type": "tableCell",
                  "text": "für 0,25 ha jährlich 70,00 DM"
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "17. Grasnutzung"
                },
                {
                  "type": "tableCell",
                  "text": "für 0,25 ha jährlich 66,00 DM"
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "18. Kleeland"
                },
                {
                  "type": "tableCell",
                  "text": "für 0,25 ha jährlich 66,00 DM"
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "19. Getreideland"
                },
                {
                  "type": "tableCell",
                  "text": "für 0,25 ha jährlich 72,00 DM"
                }
              ]
            }
          ]
