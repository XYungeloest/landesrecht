  "body": [
    {
      "type": "paragraphText",
      "text": "Der Landtag hat das folgende Gesetz beschlossen:"
    },
    {
      "type": "article",
      "label": "Artikel 1",
      "title": "Allgemeines",
      "children": [
        {
          "type": "paragraph",
          "label": "§ 1",
          "title": "Zweck des Gesetzes",
          "children": [
            {
              "type": "subparagraph",
              "label": "(1)",
              "text": "Dieses Gesetz dient dem Schutz von Frauen und ihren mitbetroffenen Kindern vor häuslicher und geschlechtsspezifischer Gewalt."
            },
            {
              "type": "subparagraph",
              "label": "(2)",
              "text": "Ziel ist die Gewährleistung eines sofortigen, sicheren und anonymen Zugangs zu Schutz, Beratung und Unterstützung. ."
            }
          ]
        },
        {
          "type": "paragraph",
          "label": "§ 2",
          "title": "Rechtsanspruch auf Schutz",
          "children": [
            {
              "type": "subparagraph",
              "label": "(1)",
              "text": "Jede von Gewalt bedrohte oder betroffene Frau hat gemeinsam mit ihren minderjährigen Kindern Anspruch auf unverzügliche Aufnahme in eine anerkannte Schutzeinrichtung."
            },
            {
              "type": "subparagraph",
              "label": "(2)",
              "text": "Der Anspruch besteht unabhängig von Einkommen, Staatsangehörigkeit, Aufenthaltsstatus, Behinderung, Religion oder Herkunft."
            }
          ]
        },
        {
          "type": "paragraph",
          "label": "§ 3",
          "title": "Begriffsbestimmungen",
          "children": [
            {
              "type": "subparagraph",
              "label": "(1)",
              "text": "Frauenhäuser sind spezialisierte Schutz- und Beratungseinrichtungen für gewaltbetroffene Frauen und Kinder."
            },
            {
              "type": "subparagraph",
              "label": "(2)",
              "text": "Kinder gelten als eigenständig schutzbedürftig."
            },
            {
              "type": "subparagraph",
              "label": "(3)",
              "text": "Gewalt umfasst insbesondere körperliche, psychische, sexuelle, digitale und ökonomische Gewalt."
            }
          ]
        }
      ]
    },
    {
      "type": "article",
      "label": "Artikel 2",
      "title": "Versorgungssicherung",
      "children": [
        {
          "type": "paragraph",
          "label": "§ 4",
          "title": "Verantwortung des Landes",
          "children": [
            {
              "type": "subparagraph",
              "label": "(1)",
              "text": "Das Land trägt die Gesamtverantwortung für die Sicherstellung ausreichender Schutzplätze."
            },
            {
              "type": "subparagraph",
              "label": "(2)",
              "text": "Es gewährleistet eine flächendeckende, bedarfsgerechte Infrastruktur."
            }
          ]
        },
        {
          "type": "paragraph",
          "label": "§ 5",
          "title": "Zielgröße und Ausbaupflicht",
          "children": [
            {
              "type": "subparagraph",
              "label": "(1)",
              "text": "Das Land stellt bis spätestens sieben Jahre nach Inkrafttreten dieses Gesetzes mindestens 100 Frauenhäuser mit insgesamt mindestens 2.000 Schutz Plätzen bereit."
            },
            {
              "type": "subparagraph",
              "label": "(2)",
              "text": "Der Ausbau erfolgt stufenweise nach einem verbindlichen Zeit- und Maßnahmenplan, der innerhalb von sechs Monaten nach Inkrafttreten durch das zuständige Ministerium zu veröffentlichen ist."
            },
            {
              "type": "subparagraph",
              "label": "(3)",
              "text": "Der Zeit- und Maßnahmenplan hat jährliche Ausbauziele sowie regionale Prioritäten festzulegen."
            }
          ]
        },
        {
          "type": "paragraph",
          "label": "§ 6",
          "title": "Regionale Verteilung",
          "children": [
            {
              "type": "subparagraph",
              "label": "(1)",
              "text": "Schutzplätze sind so zu verteilen, dass jede schutzsuchende Person ein Frauenhaus grundsätzlich innerhalb von 60 Kilometern erreichen kann."
            },
            {
              "type": "subparagraph",
              "label": "(2)",
              "text": "Besondere Bedarfe in Ballungsräumen und strukturschwachen Regionen sind vorrangig zu berücksichtigen."
            }
          ]
        },
        {
          "type": "paragraph",
          "label": "§ 7",
          "title": "Zentrale Platz Koordination",
          "children": [
            {
              "type": "subparagraph",
              "label": "(1)",
              "text": "Das Land richtet eine digitale Koordinierungsstelle für freie Schutzplätze ein."
            },
            {
              "type": "subparagraph",
              "label": "(2)",
              "text": "Beratungsstellen, Polizei und Gerichte erhalten Zugriff zur unmittelbaren Vermittlung."
            }
          ]
        }
      ]
    },
    {
      "type": "article",
      "label": "Artikel 3",
      "title": "Aufgaben der Einrichtungen",
      "children": [
        {
          "type": "paragraph",
          "label": "§ 8",
          "title": "Leistungen",
          "children": [
            {
              "type": "paragraphText",
              "text": "Frauenhäuser gewährleisten insbesondere:"
            },
            {
              "type": "item",
              "label": "1.",
              "text": "sichere Unterkunft und Schutz,"
            },
            {
              "type": "item",
              "label": "2.",
              "text": "psychosoziale Beratung,"
            },
            {
              "type": "item",
              "label": "3.",
              "text": "Unterstützung in rechtlichen und sozialen Angelegenheiten,"
            },
            {
              "type": "item",
              "label": "4.",
              "text": "Hilfe bei Existenzsicherung und Wohnungsfindung,"
            },
            {
              "type": "item",
              "label": "5.",
              "text": "Präventions- und Stabilisierungshilfen"
            }
          ]
        },
        {
          "type": "paragraph",
          "label": "§ 9",
          "title": "Schutz und Förderung von Kindern",
          "children": [
            {
              "type": "subparagraph",
              "label": "(1)",
              "text": "Kinder erhalten altersgerechte Betreuung und psychosoziale Unterstützung."
            },
            {
              "type": "subparagraph",
              "label": "(2)",
              "text": "Kooperationen mit Jugendämtern erfolgen unter Wahrung der Rechte der Sorgeberechtigten und des Kindeswohls."
            }
          ]
        },
        {
          "type": "paragraph",
          "label": "§ 10",
          "title": "Vertraulichkeit und Barrierefreiheit",
          "children": [
            {
              "type": "subparagraph",
              "label": "(1)",
              "text": "Die Standorte der Einrichtungen sind vertraulich zu behandeln. Sie sind bei der Koordinierungsstelle oder bei den Behörden zu erfahren, um den Schutz zu gewährleisten."
            },
            {
              "type": "subparagraph",
              "label": "(2)",
              "text": "Neubauten müssen barrierefrei ausgestaltet sein; bestehende Einrichtungen sind schrittweise anzupassen und fallen unter den Bestandsschutz ."
            }
          ]
        }
      ]
    },
    {
      "type": "article",
      "label": "Artikel 4",
      "title": "Qualität und Aufsicht",
      "children": [
        {
          "type": "paragraph",
          "label": "§ 11",
          "title": "Qualitätsstandards",
          "children": [
            {
              "type": "paragraphText",
              "text": "Das zuständige Ministerium legt durch Rechtsverordnung verbindliche Mindeststandards fest, insbesondere zu"
            },
            {
              "type": "item",
              "label": "1.",
              "text": "Personalqualifikation und Schutzkonzepten,"
            },
            {
              "type": "item",
              "label": "2.",
              "text": "Kinderschutz,"
            },
            {
              "type": "item",
              "label": "3.",
              "text": "Datenschutz und Sicherheit,"
            },
            {
              "type": "item",
              "label": "4.",
              "text": "barrierefreier Ausgestaltung."
            }
          ]
        },
        {
          "type": "paragraph",
          "label": "§ 12",
          "title": "Aufsicht und Berichtspflicht",
          "children": [
            {
              "type": "subparagraph",
              "label": "(1)",
              "text": "Das Land überwacht die Einhaltung der Standards."
            },
            {
              "type": "subparagraph",
              "label": "(2)",
              "text": "Träger übermitteln jährlich anonymisierte Daten zu Auslastung, Abweisungen und Unterstützungsleistungen."
            }
          ]
        }
      ]
    },
    {
      "type": "article",
      "label": "Artikel 5",
      "title": "Finanzierung",
      "children": [
        {
          "type": "paragraph",
          "label": "§ 13",
          "title": "Landesfinanzierung",
          "children": [
            {
              "type": "subparagraph",
              "label": "(1)",
              "text": "Das Land trägt die erforderlichen Kosten für Betrieb, Personal und Investitionen der anerkannten Einrichtungen."
            },
            {
              "type": "subparagraph",
              "label": "(2)",
              "text": "Die Finanzierung erfolgt durch eine jährliche Basisförderung sowie ergänzende fallbezogene Mittel."
            },
            {
              "type": "subparagraph",
              "label": "(3)",
              "text": "Investitionsmittel sind mehrjährig planbar bereitzustellen."
            }
          ]
        },
        {
          "type": "paragraph",
          "label": "§ 14",
          "title": "Anerkennung und Fördervoraussetzungen",
          "children": [
            {
              "type": "paragraphText",
              "text": "Eine Einrichtung wird anerkannt, wenn sie"
            },
            {
              "type": "item",
              "label": "1.",
              "text": "gemeinnützig betrieben wird,"
            },
            {
              "type": "item",
              "label": "2.",
              "text": "die Qualitätsstandards erfüllt,"
            },
            {
              "type": "item",
              "label": "3.",
              "text": "ein verbindliches Schutz- und Sicherheitskonzept vorliegt."
            }
          ]
        }
      ]
    },
    {
      "type": "article",
      "label": "Artikel 6",
      "title": "Schlussbestimmungen",
      "children": [
        {
          "type": "paragraph",
          "label": "§ 15",
          "title": "Zusammenarbeit öffentlicher Stellen",
          "children": [
            {
              "type": "paragraphText",
              "text": "Polizei, Gerichte, Gesundheits- und Sozialbehörden wirken bei der schnellen Vermittlung in Schutzplätze sowie der sozialen Stabilisierung der Betroffenen zusammen."
            }
          ]
        },
        {
          "type": "paragraph",
          "label": "§ 16",
          "title": "Übergangs- und Evaluation Regelungen",
          "children": [
            {
              "type": "subparagraph",
              "label": "(1)",
              "text": "Der Ausbau auf die in §5 genannte Zielgröße erfolgt schrittweise innerhalb eines Zeitraums von sieben Jahren."
            },
            {
              "type": "subparagraph",
              "label": "(2)",
              "text": "Die Landesregierung legt dem Parlament jährlich einen Fortschrittsbericht über den Stand des Ausbaus, die erreichten Schutzplatzkapazitäten und die regionale Verteilung vor."
            },
            {
              "type": "subparagraph",
              "label": "(3)",
              "text": "Wird ein Jahresziel um mehr als zehn Prozent unterschritten, hat das zuständige Ministerium binnen drei Monaten ein Nach Steuerungskonzept vorzulegen."
            }
          ]
        },
        {
          "type": "paragraph",
          "label": "§ 17",
          "title": "Inkrafttreten",
          "children": [
            {
              "type": "paragraphText",
              "text": "Dieses Gesetz tritt am Tag der Verkündung in Kraft."
            }
          ]
        }
      ]
    },
    {
      "type": "paragraphText",
      "text": "Landesregierung"
    },
    {
      "type": "signature",
      "label": "Hamburg, den 03. Februar 2026",
      "title": "Ministerpräsident",
      "text": "Ulbricht"
    }
  ]
}
