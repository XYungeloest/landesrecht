          "type": "item",
          "label": "1.",
          "text": "Soest - Kreis Soest - Bad-Sassendorf",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "Borken - Kreis Borken - Borken",
          "level": 0,
