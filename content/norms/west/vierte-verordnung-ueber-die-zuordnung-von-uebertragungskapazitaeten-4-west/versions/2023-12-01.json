        {
          "type": "footnote",
          "label": "Fn 4",
          "text": "§§ 1, 2, 3 und 4 entfallen; Änderungsvorschriften zum 3. Rundfunkänderungsgesetz v. 18. 6. 1991 (GV. NW. S. 254)."
        }
      ]
    },
