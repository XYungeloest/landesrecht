    { "label": "1", "text": "§ 3 geändert durch Gesetz vom 21. Juli 2023 (GV. West S. 640)" }
  ],
  "body": [
    { "type": "paragraphText", "text": "Vom 15. Februar 2005" },
    {
      "type": "preamble",
      "title": "Vorbemerkung",
      "children": [
        { "type": "paragraphText", "text": "Der Landtag hat das folgende Gesetz beschlossen, das hiermit verkündet wird." }
      ]
    },
    {
      "type": "part",
      "label": "Erster Teil",
      "title": "Allgemeine Grundlagen",
      "children": [
        {
          "type": "chapter",
          "label": "1. Kapitel",
          "title": "Auftrag der Schule",
          "children": [
            {
              "type": "section",
              "label": "1. Abschnitt",
              "title": "Grundsätze",
              "children": [
                {
                  "type": "paragraph",
                  "label": "§ 1",
                  "title": "Recht auf Bildung",
                  "children": [
                    { "type": "subparagraph", "label": "(1)", "text": "Jeder junge Mensch hat ohne Rücksicht auf seine wirtschaftliche Lage und Herkunft ein Recht auf schulische Bildung und Erziehung.", "children": [] },
                    { "type": "subparagraph", "label": "(2)", "text": "Die Schule fördert die Entfaltung der Person und die Bereitschaft zu verantwortlichem Handeln in der Gemeinschaft.", "children": [] }
                  ]
                },
                {
                  "type": "paragraph",
                  "label": "§ 2",
                  "title": "Bildungs- und Erziehungsauftrag",
                  "children": [
                    { "type": "subparagraph", "label": "(1)", "text": "Die Schule unterrichtet und erzieht junge Menschen auf der Grundlage des Grundgesetzes und der Verfassung des Landes Westdeutschland.", "children": [] },
                    { "type": "subparagraph", "label": "(2)", "text": "Die Schüler:innen sollen insbesondere lernen,", "children": [] },
                    { "type": "item", "label": "1.", "text": "selbstständig und in sozialer Verantwortung zu handeln,", "level": 0, "numberingStyle": "decimal", "children": [] },
                    { "type": "item", "label": "2.", "text": "eigene Meinungen zu entwickeln und die Meinungen anderer zu achten,", "level": 0, "numberingStyle": "decimal", "children": [] },
                    {
                      "type": "item", "label": "3.", "text": "grundlegende Kompetenzen zu erwerben, insbesondere", "level": 0, "numberingStyle": "decimal",
                      "children": [
                        { "type": "subitem", "label": "a)", "text": "sprachliche und mathematische Grundbildung,", "level": 1, "numberingStyle": "lower-alpha", "children": [] },
                        { "type": "subitem", "label": "b)", "text": "informationstechnische Grundbildung.", "level": 1, "numberingStyle": "lower-alpha", "children": [] }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "section",
              "label": "2. Abschnitt",
              "title": "Schulpflicht",
              "children": [
                {
                  "type": "paragraph",
                  "label": "§ 3",
                  "title": "Schulpflicht",
                  "children": [
                    { "type": "subparagraph", "label": "(1)", "text": "Schulpflichtig ist, wer im Land Westdeutschland seinen Wohnsitz oder gewöhnlichen Aufenthalt hat.", "children": [] },
                    { "type": "subparagraph", "label": "(2)", "text": "Die Schulpflicht beginnt für Kinder, die bis zum Beginn des 30. September das sechste Lebensjahr vollendet haben, am 1. August desselben Kalenderjahres.", "children": [] },
                    { "type": "subparagraph", "label": "(3)", "text": "Die Schulpflicht endet mit dem Abschluss der Sekundarstufe I oder nach zehn Schulbesuchsjahren.", "children": [] }
                  ]
                },
                {
                  "type": "paragraph",
                  "label": "§ 4",
                  "title": "Erfüllung der Schulpflicht",
                  "children": [
                    { "type": "subparagraph", "label": "(1)", "text": "Die Schulpflicht wird durch den Besuch einer öffentlichen Schule oder einer Ersatzschule erfüllt.", "children": [] }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "part",
      "label": "Zweiter Teil",
      "title": "Schlussbestimmungen",
      "children": [
        {
          "type": "paragraph",
          "label": "§ 10",
          "title": "Inkrafttreten",
          "children": [
            { "type": "paragraphText", "text": "Dieses Gesetz tritt am 1. August 2005 in Kraft." },
            { "type": "footnote", "label": "1", "text": "Die Vorschrift ist am 1. August 2005 in Kraft getreten." }
          ]
        }
      ]
    },
    {
