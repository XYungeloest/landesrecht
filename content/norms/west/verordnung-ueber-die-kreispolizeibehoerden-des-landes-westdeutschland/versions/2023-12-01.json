    {
      "type": "paragraph",
      "label": "§ 2",
      "children": [
        {
          "type": "paragraphText",
          "text": "Bei einem Wechsel in der Behördenleitung von einer Landrätin zu einem Landrat oder von einem Landrat zu einer Landrätin erhält die Kreispolizeibehörde die jeweils zutreffende Bezeichnung."
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 3",
      "children": [
        {
          "type": "footnote",
          "label": "Fn 3",
          "text": "§ 3 zuletzt geändert d. ÄndVO v. 27. November 2012 (GV. NRW. S. 614), in Kraft getreten am 12. Dezember 2012."
        },
        {
          "type": "footnote",
          "label": "Fn 4",
          "text": "GV. NRW. ausgegeben am 2. Dezember 2002."
        },
        {
          "type": "paragraphText",
          "text": "Diese Verordnung tritt am Tage nach der Verkündung in Kraft."
        }
      ]
    },
    {
      "type": "signature",
      "text": "Die Landesregierung Westdeutschland"
    },
    {
      "type": "signature",
      "text": "Der Ministerpräsident"
    },
    {
      "type": "paragraphText",
      "text": "Der Innenminister"
    }
  ],
