                }
              ]
            },
            {
              "type": "subparagraph",
              "label": "(3)",
              "text": "Bei der Berechnung des Heizkostenbetrags ist von der tatsächlich beheizbaren, höchstens jedoch von folgender Wohnfläche auszugehen:",
              "children": [
                {
                  "type": "table",
                  "columns": 2,
                  "children": [
                    {
                      "type": "tableRow",
                      "children": [
                        {
