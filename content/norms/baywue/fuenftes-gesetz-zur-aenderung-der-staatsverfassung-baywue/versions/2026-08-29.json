  "body": [
    {
      "type": "article",
      "label": "Artikel 1",
      "title": "Änderung der Staatsverfassung",
      "children": [
        {
          "type": "paragraphText",
          "text": "Die Verfassung des Freistaates Bayern-Württemberg vom 12. Januar 2025, die zuletzt durch Artikel 1 des zweiten Gesetzes zur Änderung der Staatsverfassung vom 29. Mai 2026 geändert worden ist, wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "Der Artikel 46 wird durch den folgenden Absatz ergänzt:",
          "level": 1,
          "children": [
            {
              "type": "quotedProvision",
              "children": [
                {
                  "type": "subparagraph",
                  "label": "(5)",
                  "text": "Der Ministerpräsident ernannt und entlässt die Staatsminister und Staatssekretäre. Sie werden nach dessen Wahl vereidigt.“"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "article",
      "label": "Artikel 2",
      "title": "Inkrafttreten",
      "children": [
        {
          "type": "paragraphText",
          "text": "Das Gesetz tritt am Tage seiner Bekanntmachung in Kraft."
        }
      ]
    },
    {
      "type": "signature",
      "title": "Der MINISTERPRÄSIDENT",
      "text": "Marcus För"
    }
  ]
