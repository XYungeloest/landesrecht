                },
                {
                  "type": "tableCell",
                  "text": "424,12\n\n318,09\n\n212,06"
                },
                {
                  "type": "tableCell",
                  "text": "361,28\n\n270,96\n\n180,64"
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "schwerpflegebedürftig\n\n(Pflegestufe II)"
                },
                {
                  "type": "tableCell",
                  "text": "21 Std.\n\n14 Std."
                },
                {
                  "type": "tableCell",
                  "text": "53,3333\n\n35,5555"
                },
                {
                  "type": "tableCell",
                  "text": "1.512,00\n\n1.008,00"
                },
                {
                  "type": "tableCell",
                  "text": "1.288,00\n\n858,67"
                },
                {
                  "type": "tableCell",
                  "text": "282,74\n\n188,50"
                },
                {
                  "type": "tableCell",
                  "text": "240,86\n\n160,57"
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "erheblich pflegebedürftig\n\n(Pflegestufe I)"
                },
                {
                  "type": "tableCell",
                  "text": "14 Std."
                },
                {
                  "type": "tableCell",
                  "text": "26,6667"
                },
                {
                  "type": "tableCell",
                  "text": "756,00"
                },
                {
                  "type": "tableCell",
