                  "text": "alte Länder"
                },
                {
                  "type": "tableCell",
                  "text": "neue Länder"
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "schwerstpflegebedürftig\n\n(Pflegestufe III)"
                },
                {
                  "type": "tableCell",
                  "text": "28 Std.\n\n21 Std.\n\n14 Std."
                },
                {
                  "type": "tableCell",
                  "text": "80\n\n60\n\n40"
                },
                {
                  "type": "tableCell",
                  "text": "2.268,00\n\n1.701,00\n\n1.134,00"
                },
                {
