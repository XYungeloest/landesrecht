          "type": "paragraphText",
          "text": "München, den 21. Dezember 1995"
        },
        {
          "type": "paragraphText",
          "text": "Bayern-Württembergisches Staatsministerium der Justiz"
        },
        {
          "type": "paragraphText",
          "text": "Hermann Leeb, Staatsminister"
        }
      ]
    }
