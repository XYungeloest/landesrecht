    {
      "type": "paragraph",
      "label": "§ 5",
      "title": "Anbaugebiet Tettnang",
      "children": [
        {
          "type": "paragraphText",
          "text": "Zum Anbaugebiet Tettnang (Baden-Württemberg) gehören folgende Gemeinden:"
        },
        {
          "type": "item",
          "text": "im Landkreis Lindau (Bodensee)",
