          "label": "A)",
          "text": "Im Regierungsbezirk Oberbayern",
          "level": 1,
          "children": [
            {
              "type": "subitem",
              "label": "1.",
              "text": "Schloss- und Gartenverwaltung Herrenchiemsee,",
              "level": 2
            },
            {
              "type": "subitem",
              "label": "2.",
              "text": "Schloss- und Gartenverwaltung Linderhof,",
              "level": 2
            },
            {
              "type": "subitem",
