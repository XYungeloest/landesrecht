  "body": [
    {
      "type": "article",
      "label": "Artikel 1",
      "title": "Änderung des Feiertagsgesetz",
      "children": [
        {
          "type": "paragraphText",
          "text": "Artikel 1 des Gesetz über den Schutz der Sonn- und Feiertage in der in der Bayerischen Rechtssammlung (BayRS 1131-3-I) veröffentlichten bereinigten Fassung, das zuletzt durch § 1 Absatz. 10 der Verordnung vom 26. März 2019 (GVBl. S. 98) geändert worden ist, wird wie folgt gefasst:"
        },
        {
          "type": "quotedProvision",
          "children": [
            {
              "type": "article",
              "label": "Art. 1",
              "title": "Gesetzliche Feiertage",
              "children": [
                {
                  "type": "subparagraph",
                  "label": "(1)",
                  "text": "Gesetzliche Feiertage sind:",
                  "children": [
                    {
                      "type": "item",
                      "label": "1.",
                      "text": "im ganzen Staatsgebiet",
                      "level": 1,
                      "children": [
                        {
                          "type": "paragraphText",
                          "text": "Neujahr, (1. Januar)"
                        },
                        {
                          "type": "paragraphText",
                          "text": "Heilige Drei Könige (Epiphanias), (6. Januar)"
                        },
                        {
                          "type": "paragraphText",
                          "text": "Weltfrauentag, (8. März)"
                        },
                        {
                          "type": "paragraphText",
                          "text": "Karfreitag,"
                        },
                        {
                          "type": "paragraphText",
                          "text": "Ostermontag,"
                        },
                        {
                          "type": "paragraphText",
                          "text": "der Tag der Arbeit, (1. Mai)"
                        },
                        {
                          "type": "paragraphText",
                          "text": "der Star Wars Tag (4. Mai),"
                        },
                        {
                          "type": "paragraphText",
                          "text": "Christi Himmelfahrt,"
                        },
                        {
                          "type": "paragraphText",
                          "text": "Pfingstmontag,"
                        },
                        {
                          "type": "paragraphText",
                          "text": "Fronleichnam,"
                        },
                        {
                          "type": "paragraphText",
                          "text": "der Tag der Deutschen Einheit, (3. Oktober)"
                        },
                        {
                          "type": "paragraphText",
                          "text": "Allerheiligen, (1. November)"
                        },
                        {
                          "type": "paragraphText",
                          "text": "Erster Weihnachtstag, (25. Dezember)"
                        },
                        {
                          "type": "paragraphText",
                          "text": "Zweiter Weihnachtstag (26 Dezember)"
                        }
                      ]
                    },
                    {
                      "type": "item",
                      "label": "2.",
                      "text": "in Gemeinden mit überwiegend katholischer Bevölkerung Mariä Himmelfahrt.“",
                      "level": 1
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "article",
      "label": "Artikel 2",
      "title": "Inkrafttreten",
      "children": [
        {
          "type": "paragraphText",
          "text": "Das Gesetz tritt am Tage nach seiner Verkündung in Kraft."
        }
      ]
    },
    {
