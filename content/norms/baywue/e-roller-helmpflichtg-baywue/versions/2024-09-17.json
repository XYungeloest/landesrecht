  "body": [
    {
      "type": "article",
      "label": "Artikel 1",
      "title": "Helmpflicht",
      "children": [
        {
          "type": "item",
          "label": "1.",
          "text": "Alle Fahrer von Elektro-Rollern sind verpflichtet, während der Fahrt einen geeigneten Schutzhelm zu tragen.",
          "level": 1
        },
        {
          "type": "item",
          "label": "2.",
          "text": "Der Schutzhelm muss den geltenden Sicherheitsstandards entsprechen und ordnungsgemäß befestigt sein.",
          "level": 1
        }
      ]
    },
    {
      "type": "article",
      "label": "Artikel 2",
      "title": "Kontrolle und Durchsetzung",
      "children": [
        {
          "type": "item",
          "label": "1.",
          "text": "Die Einhaltung der Helmpflicht wird durch die Polizei und andere zuständige Behörden überwacht.",
          "level": 1
        },
        {
          "type": "item",
          "label": "2.",
          "text": "Bei Verstößen gegen die Helmpflicht werden entsprechende Bußgelder erhoben. Die Höhe der Bußgelder wird durch eine gesonderte Verordnung festgelegt.",
          "level": 1
        }
      ]
    },
    {
      "type": "article",
      "label": "Artikel 3",
      "title": "Ausnahmen",
      "children": [
        {
          "type": "item",
          "label": "1.",
          "text": "Personen, die aus medizinischen Gründen nachweislich keinen Helm tragen können, sind von der Helmpflicht ausgenommen.",
          "level": 1
        },
        {
          "type": "item",
          "label": "2.",
          "text": "Weitere Ausnahmen können durch eine gesonderte Verordnung festgelegt werden.",
          "level": 1
        }
      ]
    },
    {
      "type": "article",
      "label": "Artikel 4",
      "title": "Inkrafttreten",
      "children": [
        {
          "type": "paragraphText",
          "text": "Das Gesetz tritt am Tage nach der Verkündung in Kraft."
        }
      ]
    },
    {
      "type": "signature",
      "title": "STAATSMINISTERIN FÜR VERKEHR UND INFRASTRUKTUR",
      "text": "LIZZ FREDERICKSEN"
    }
  ]
}
