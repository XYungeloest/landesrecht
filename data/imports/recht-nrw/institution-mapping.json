{
  "schemaVersion": "recht-nrw-institution-mapping/1",
  "description": "Zentrale Zuordnung von Institutionen Nordrhein-Westfalens für die Rechtsüberleitung nach Westdeutschland (docs/RECHT_NRW_BULK_READINESS.md, Abschnitt Institutionen). Quellorgane bleiben immer als originEnactingBody erhalten; ein Simulationsorgan entsteht nur bei Status map oder bei sicheren Verfassungsorganen. Status review ist nicht bulk-blockierend (imported-with-warnings) und bleibt messbar.",
  "defaults": {
    "ministry": "review",
    "authority": "review",
    "public-body": "review",
    "regional-body": "review",
    "municipality": "review",
    "geography": "review",
    "institution": "review",
    "legislature": "safe-transform"
  },
  "entries": [
    {
      "id": "landtag",
      "group": "Landtag",
      "category": "legislature",
      "match": ["Landtag Nordrhein-Westfalen", "Landtag von Nordrhein-Westfalen", "Landtag des Landes Nordrhein-Westfalen"],
      "status": "safe-transform",
      "target": "Landtag Westdeutschland",
      "reason": "Verfassungsorgan, das in jedem Land besteht; nur die Landesbezeichnung wird übergeleitet (transform/organs.ts, Regel jurisdiction-name).",
      "reviewedAt": "2026-09-15"
    },
    {
      "id": "landesregierung",
      "group": "Landesregierung NRW",
      "category": "institution",
      "match": ["Landesregierung Nordrhein-Westfalen", "Landesregierung des Landes Nordrhein-Westfalen", "Landesregierung von Nordrhein-Westfalen"],
      "status": "safe-transform",
      "target": "Landesregierung Westdeutschland",
      "reason": "Verfassungsorgan; nur die Landesbezeichnung wird übergeleitet.",
      "reviewedAt": "2026-09-15"
    },
    {
      "id": "ministerpraesident",
