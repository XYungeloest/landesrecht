        "citation": "KWMBl. 2011 S. 129"
      },
      {
        "kind": "registry-position",
        "dimension": "validity",
        "strength": "supporting",
        "statement": "Fortgeltung ab 1. Januar 2016 nach Nr. 1 VwVWBek: in der Positivliste als „Hilfsmittel bei Leistungsnachweisen an bayerischen Gymnasien, Abendgymnasien und Kollegs“ (Erlassdatum 2011-06-07, Fassungsdatum 2011-06-07) geführt",
        "date": "2016-01-01",
        "sourceUrl": "https://www.verkuendung-bayern.de/fileadmin/Anlage_1_Positivliste_veroeffentlichte_Verwaltungsvorschriften.pdf",
