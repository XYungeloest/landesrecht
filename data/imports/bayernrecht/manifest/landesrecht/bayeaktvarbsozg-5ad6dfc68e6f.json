    "validityEvidence": [
      {
        "kind": "reconstruction",
        "dimension": "begin",
        "strength": "strong",
        "statement": "Die Stichtagsfassung gilt seit 2023-05-17: Stammfassung: Der Einleitungssatz der ältesten zurückgenommenen Änderung nennt keine vorangehende, Änderungsverlauf und Fortführungsnachweis führen vor dem Stichtag keine; Inkrafttretensvorschrift im Stichtagstext, § 6 Inkrafttreten, Außerkrafttreten: „Diese Verordnung tritt am 17. Mai 2023 in Kraft.“; Alttext nicht umkehrbarer Befehle aus der Stammverkündung GVBl. 2023 S. 190 (https://www.verkuendung-bayern.de/gvbl/2023-190/, SHA-256 af27c285b681df37…); Wortlaut gleich (3353 Zeichen, typografisch vereinheitlicht)",
        "date": "2023-05-17",
        "citation": "Arbeits- und Sozialgerichtliche eAkten-Verordnung (eAktV ArbSozG) vom 13. April 2023 (GVBl. S. 190, BayRS 32-2-A), die zuletzt durch § 55 des Gesetzes vom 26. März 2026 (GVBl. S. 75) geändert worden ist",
        "sourceUrl": "https://www.gesetze-bayern.de/Content/Zip/BayeAktVArbSozG"
      },
      {
        "kind": "gazette-amendment",
        "dimension": "amendment",
        "strength": "strong",
        "statement": "Geändert durch GVBl. 2026 S. 75 mit Wirkung vom 2026-04-01 (Änderung 2 von 2 nach dem Stichtag); die Rücknahme aller Änderungen in umgekehrter Reihenfolge ergibt die Stichtagsfassung, die Vorwärtsanwendung bestätigt den heutigen Text",
        "date": "2026-04-01",
        "citation": "GVBl. 2026 S. 75",
        "sourceUrl": "https://www.verkuendung-bayern.de/gvbl/2026-75/",
        "sha256": "97a4022d212061fa5b5d2550524d9998afc318d757bafec0a597f7c4abd76f06"
