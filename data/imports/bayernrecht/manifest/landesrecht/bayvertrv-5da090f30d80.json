    "validityEvidence": [
      {
        "kind": "reconstruction",
        "dimension": "begin",
        "strength": "strong",
        "statement": "Die Stichtagsfassung gilt seit 2021-12-01: Stammfassung: Der Einleitungssatz der ältesten zurückgenommenen Änderung nennt keine vorangehende, Änderungsverlauf und Fortführungsnachweis führen vor dem Stichtag keine; Inkrafttretensvorschrift im Stichtagstext, § 12 Inkrafttreten, Außerkrafttreten: „Diese Verordnung tritt am 1. Dezember 2021 in Kraft.“; Alttext nicht umkehrbarer Befehle aus der Stammverkündung GVBl. 2021 S. 610 (https://www.verkuendung-bayern.de/gvbl/2021-610/, SHA-256 bc724bc5a1bb8c8a…); Wortlaut gleich (21408 Zeichen, typografisch vereinheitlicht)",
        "date": "2021-12-01",
        "citation": "Vertretungsverordnung (VertrV) vom 26. Oktober 2021 (GVBl. S. 610, BayRS 600-1-F), die zuletzt durch § 2 der Verordnung vom 10. März 2026 (GVBl. S. 146) geändert worden ist",
        "sourceUrl": "https://www.gesetze-bayern.de/Content/Zip/BayVertrV"
      },
      {
        "kind": "gazette-amendment",
        "dimension": "amendment",
        "strength": "strong",
        "statement": "Geändert durch GVBl. 2026 S. 146 mit Wirkung vom 2026-04-01 (Änderung 2 von 2 nach dem Stichtag); die Rücknahme aller Änderungen in umgekehrter Reihenfolge ergibt die Stichtagsfassung, die Vorwärtsanwendung bestätigt den heutigen Text",
        "date": "2026-04-01",
        "citation": "GVBl. 2026 S. 146",
        "sourceUrl": "https://www.verkuendung-bayern.de/gvbl/2026-146/",
        "sha256": "92c96e2cb2e9e9f2024a88f4496db3cf35637296781c669a17c921ba7bf8e98d"
      },
      {
        "kind": "gazette-amendment",
        "dimension": "amendment",
        "strength": "strong",
        "statement": "Geändert durch GVBl. 2025 S. 570 mit Wirkung vom 2025-12-31 (Änderung 1 von 2 nach dem Stichtag); die Rücknahme aller Änderungen in umgekehrter Reihenfolge ergibt die Stichtagsfassung, die Vorwärtsanwendung bestätigt den heutigen Text",
        "date": "2025-12-31",
