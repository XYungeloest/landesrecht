                          {
                            "type": "paragraphText",
                            "text": "Heilige Drei Könige (Epiphanias), (6. Januar)"
                          },
                          {
                            "type": "paragraphText",
                            "text": "Weltfrauentag, (8. März)"
                          },
                          {
                            "type": "paragraphText",
                            "text": "Karfreitag,"
                          },
                          {
                            "type": "paragraphText",
                            "text": "Ostermontag,"
                          },
                          {
                            "type": "paragraphText",
                            "text": "der Tag der Arbeit, (1. Mai)"
                          },
                          {
                            "type": "paragraphText",
                            "text": "der Star Wars Tag (4. Mai),"
                          },
                          {
                            "type": "paragraphText",
                            "text": "Christi Himmelfahrt,"
                          },
                          {
                            "type": "paragraphText",
                            "text": "Pfingstmontag,"
                          },
                          {
                            "type": "paragraphText",
                            "text": "Fronleichnam,"
