      "expectedHash": "134ad63880c5943bfaf4bd2207052ebde16465db45758ae46c2e4745f91b8abb",
      "expectedMatches": 1,
      "value": {
        "type": "article",
        "label": "Artikel 47",
        "title": "Auflösung des Landtages",
        "children": [
          {
            "type": "paragraphText",
            "text": "Wenn der Landtag nach der Frist des Artikels 46 Absatz 4 Satz 1 keinen Ministerpräsidenten gewählt hat, ist der Landtag aufgelöst. Der Landtag hat während der Frist das Recht sich aufzulösen, solange kein Ministerpräsident gewählt wird.",
            "children": []
          }
        ]
      },
      "source": "baywue/simulation/f24b1dab46f228ee2d280837a02fdf30da278478e7ddfaedb60a8a7e42708fdc.pdf",
      "sourceProvision": "Artikel 1 Nummer 1",
      "effectiveDate": "2026-05-29"
    },
    {
      "op": "replaceProvision",
      "target": {
        "type": "article",
        "label": "Artikel 54"
      },
      "expectedHash": "a61625c0dd8157131d1fa6392f7b2a61802a3f2e99db47e2014da9187c9baad0",
      "expectedMatches": 1,
      "value": {
        "type": "article",
        "label": "Artikel 54",
        "title": "Misstrauensvotum",
        "children": [
          {
            "type": "subparagraph",
            "label": "(1)",
            "text": "Der Landtag hat das Recht dem Ministerpräsident das Misstrauen aussprechen oder die Abberufung eines Mitglieds der Staatsregierung zu verlangen. Er kann dem Ministerpräsidenten das Vertrauen nur dadurch entziehen, indem er einen neuen Ministerpräsidenten wählt.",
            "children": []
          },
          {
            "type": "subparagraph",
            "label": "(2)",
            "text": "Verlangt nach Absatz 1 der Landtag die Absetzung eines Mitglieds der Staatsregierung, so muss der Ministerpräsident dem Verlangen entsprechen. Eine Ernennung derselben Person scheidet für dieselbe Regierung aus.",
            "children": []
          },
          {
            "type": "subparagraph",
            "label": "(3)",
            "text": "Zwischen Antrag und Wahl müssen achtundvierzig Stunden liegen.",
            "children": []
          }
        ]
      },
      "source": "baywue/simulation/f24b1dab46f228ee2d280837a02fdf30da278478e7ddfaedb60a8a7e42708fdc.pdf",
      "sourceProvision": "Artikel 1 Nummer 2",
      "effectiveDate": "2026-05-29"
    },
    {
      "op": "insertProvisionAfter",
      "target": {
        "type": "article",
        "label": "Artikel 54"
      },
      "expectedHash": "0f9d220a13235bf86b3b06b2962f86507ae40d9cdceaa35d2f5a37360f144e88",
      "expectedMatches": 1,
      "value": {
        "type": "article",
        "label": "Artikel 54a",
        "title": "Vertrauensfrage",
        "children": [
          {
            "type": "subparagraph",
            "label": "(1)",
            "text": "Findet ein Antrag des Ministerpräsidenten, ihm das Vertrauen auszusprechen, nicht die Mehrheit der Mitglieder, muss dieser zurücktreten.",
            "children": []
          },
          {
            "type": "subparagraph",
            "label": "(2)",
            "text": "Der Landtag hat das Recht durch nach Artikel 46 einen neuen Ministerpräsidenten zu wählen. Gelingt das nicht innerhalb eines Monats, wird der Landtag aufgelöst.",
            "children": []
          },
          {
            "type": "subparagraph",
            "label": "(3)",
            "text": "Auf Antrag der Staatsregierung kann der Landtag nach Absatz 1 mit der Mehrheit seiner Mitglieder den Landtag auflösen.",
            "children": []
          }
        ]
      },
      "source": "baywue/simulation/f24b1dab46f228ee2d280837a02fdf30da278478e7ddfaedb60a8a7e42708fdc.pdf",
      "sourceProvision": "Artikel 1 Nummer 3",
