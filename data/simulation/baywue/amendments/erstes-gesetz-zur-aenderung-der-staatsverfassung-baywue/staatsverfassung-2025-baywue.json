      },
      "expectedHash": "189f35fe56d4ee12acb7963d163f0159c2badb98f599db72edfd6c31fcd075b9",
      "expectedMatches": 1,
      "value": {
        "type": "article",
        "label": "Artikel 46",
        "title": "Wahl des Ministerpräsidenten",
        "children": [
          {
            "type": "subparagraph",
            "label": "(1)",
            "text": "Der Ministerpräsident wird durch den Landtag auf Vorschlag von mindestens ein Viertel seiner Mitglieder gewählt.",
            "children": []
          },
          {
            "type": "subparagraph",
            "label": "(2)",
            "text": "Gewählt ist, wer die Mehrheit der Stimmen der Mitglieder auf sich vereinen kann. Absatz 1 gilt entsprechend.",
            "children": []
          },
          {
            "type": "subparagraph",
            "label": "(3)",
            "text": "Erreicht kein Kandidat die nötige Mehrheit, beginnt ein zweiter Wahlgang.",
            "children": []
          },
          {
            "type": "subparagraph",
            "label": "(4)",
            "text": "Wird nach Absatz 3 kein Kandidat gewählt, hat der Landtag innerhalb eines Monats das Recht in einem drittem und letzten Wahlgang einen Ministerpräsidenten zu wählen. Gewählt ist, wer die Mehrheit der Stimmen erhält.",
            "children": []
          }
        ]
      },
      "source": "baywue/simulation/f24b1dab46f228ee2d280837a02fdf30da278478e7ddfaedb60a8a7e42708fdc.pdf",
      "sourceProvision": "Artikel 1 Nummer 1",
      "effectiveDate": "2026-05-29"
    },
