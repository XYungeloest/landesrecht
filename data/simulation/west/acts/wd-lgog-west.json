    "body": [
      {
        "type": "preamble",
        "children": [
          {
            "type": "paragraphText",
            "text": "Der Landtag hat das folgende Gesetz beschlossen:"
          }
        ]
      },
      {
        "type": "paragraph",
        "label": "§ 1",
        "children": [
          {
            "type": "paragraphText",
            "text": "Die Geschäftsordnung des Westdeutschen Landtages und der Westdeutschen Landesregierung gelten solange fort, bis die jeweilige Institution eine neue Geschäftsordnung für sich bestätigt oder beschlossen hat."
          }
        ],
        "title": "Geschäftsordnungskontinuität"
      },
      {
        "type": "paragraph",
        "label": "§ 2",
        "children": [
          {
            "type": "paragraphText",
            "text": "Das Gesetz tritt am Tage nach der Verkündung in Kraft."
          }
        ],
        "title": "Inkrafttreten"
      },
      {
        "type": "paragraphText",
        "text": "Das vorstehende Gesetz wird hiermit ausgefertigt und im Westdeutschen Gesetzes- und Verordnungsblatt verkündet."
      },
      {
        "type": "paragraphText",
        "text": "Mainz, den 17. Mai 2026"
      },
      {
        "type": "signature",
        "title": "Die Ministerpräsidentin",
        "text": "Manuela Dreyer"
      },
      {
        "type": "signature",
        "title": "Der Landesminister des Inneren und für Kommunales",
        "text": "Sebastian Kronenberg"
      }
    ]
  },
