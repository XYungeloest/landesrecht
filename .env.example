# Öffentliche Site-URL für Canonical-Links, Sitemap und die SimRecht-Deklaration.
SITE_URL=https://landesrecht.example

# Für Deployments und Remote-D1-Projektionen (nur in der CI oder lokal, nie einchecken):
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# R2-Quellenarchiv für den RECHT.NRW-Bulkimport (S3-kompatible API, nur lokal oder in der CI setzen,
# nie einchecken; docs/RECHT_NRW_BULK_READINESS.md). Ohne diese Variablen stagt der Bulkimport die
# Rohquellen unter .cache/recht-nrw-r2-staging/ und lädt sie später mit import:recht-nrw:r2-sync hoch.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=landesrecht-quellen
